# 新規カスタムビヘイビア zmk,behavior-velocity-mouse-move 用のKconfig。
# ZMKの他のビヘイビア同様、devicetree側でこのcompatibleのノードが
# 実際に使われていれば(DT_HAS_..._ENABLED)自動的に有効になる。

config ZMK_BEHAVIOR_VELOCITY_MOUSE_MOVE
    bool "Velocity-sensitive rotary encoder mouse movement behavior"
    default y
    depends on DT_HAS_ZMK_BEHAVIOR_VELOCITY_MOUSE_MOVE_ENABLED
    select INPUT

config NAGINATA
    bool "Enable Naginata"
    default y

if NAGINATA

choice
    prompt "Naginata default OS"
    default NAGINATA_DEFAULT_OS_LINUX
    help
      薙刀式が起動時に想定するOS。実行時にF15(Windows)/F16(macOS)/F17(Linux)で切り替え可能。

config NAGINATA_DEFAULT_OS_WINDOWS
    bool "Windows"

config NAGINATA_DEFAULT_OS_MACOS
    bool "macOS"

config NAGINATA_DEFAULT_OS_LINUX
    bool "Linux"

endchoice

config NAGINATA_PERSISTENT_STATE
    bool "Naginata Persistent State"
    default y
    select SETTINGS
    help
      Enable persistent storage of Naginata state across reboots.

endif # NAGINATA
