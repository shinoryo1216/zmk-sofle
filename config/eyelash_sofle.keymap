        // ==========================================
        // 3. 共通機能レイヤー群 (Layers 7, 8, 9, 10, 11)
        // ==========================================

        layer_7_cursor {
            bindings = <
&kp ESC   &none      &none     &none      &none      &none               &none           &none          &none         &none         &none       &none       &none
&kp TAB   &kp HOME   &kp PG_UP &kp UP_ARROW &kp PG_DN &kp END            &none           &kp END        &kp PG_DN     &kp UP_ARROW  &kp PG_UP   &kp HOME    &none
&kp LCTRL &none      &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &none &kp LA(LEFT)    &none          &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &none  &none
&kp LSHFT &none      &none     &none      &none      &none               &kp LA(RIGHT)   &none          &none         &none         &none       &none       &kp RSHFT
&tog 14   &kp LALT   &lt 9 PSCRN &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 4 0 &mkp MCLK     &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
