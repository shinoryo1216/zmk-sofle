/*
 * eyelash_sofle 大西配列 実装
 *
 * おさかなキーボード公式デフォルトキーマップ（大西配列、Win優先、JIS方式）を
 * eyelash_sofleの物理配列（全段6列/手）に列単位で正確に移植したものです。
 *
 * 列の対応関係:
 *   おさかなの上段・下段は「外側4列(pinky/ring/middle/index)」のみ使用 → L2-L5 / R2-R5 に対応
 *   おさかなのホームロー(中段)は「外側余剰列＋外側4列＋内側余剰列」の6列使用 → L1-L6 / R1-R6 に対応
 *   （L1=外側余剰, L2=pinky, L3=ring, L4=middle, L5=index, L6=内側余剰）
 *   （R1=内側余剰, R2=index, R3=middle, R4=ring, R5=pinky, R6=外側余剰）
 *
 * 数字行（table Row1）はeyelash_sofle固有の物理列でおさかなには存在しないため、
 * そのまま維持しています。
 *
 * 参考:
 *  - 大西配列 公式サイト: https://o24.works/layout/
 *  - おさかなキーボード公式リポジトリ: https://github.com/TakumaOnishi/zmk-config-fish
 *  - おさかなキーボード ガイド: https://o24.works/fish/guide
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <225>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <150>;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <175>;
    quick-tap-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";
        timeout-ms = <100>;
        require-prior-idle-ms = <150>;

        /* おさかな本家 combo_lang2（A+O） → Row3(home) L4+L5 */
        combo_lang2 {
            key-positions = <29 30>;
            bindings = <&kp LANG2>;
        };

        /* おさかな本家 combo_lang1（T+N） → Row3(home) R2+R3 */
        combo_lang1 {
            key-positions = <34 35>;
            bindings = <&kp LANG1>;
        };

        /* おさかな本家 combo_reset_L（MINUS+Q+COMMA） → Row2 L5, Row3 L1, Row3 L6 */
        combo_reset_L {
            key-positions = <17 26 31>;
            bindings = <&bootloader>;
        };

        /* おさかな本家 combo_reset_R（K+G+P） → Row2 R2, Row3 R1, Row3 R6 */
        combo_reset_R {
            key-positions = <21 33 38>;
            bindings = <&bootloader>;
        };

        /* おさかな本家 combo_studio_unlock（Z+X+C+V） → Row4 L2+L3+L4+L5 */
        combo_studio_unlock {
            key-positions = <40 41 42 43>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0_onishi {
            // layer_base 相当
            bindings = <
&kp ESC   &kp N1  &kp N2       &kp N3       &kp N4        &kp N5         &kp UP_ARROW    &kp N6        &kp N7       &kp N8       &kp N9   &kp N0   &kp MINUS
&kp TAB   &kp L   &kp U        &kp F        &kp MINUS     &none          &kp DOWN_ARROW  &none         &kp K        &kp W        &kp R    &kp Y    &kp LBKT
&kp Q     &kp E   &mt LGUI I   &mt LALT A   &mt LSHFT O   &kp COMMA      &kp LEFT_ARROW  &kp G         &mt RSHFT T  &mt RALT N   &mt RGUI S &kp H  &kp P
&kp LSHFT &kp Z   &kp X        &kp C        &kp V         &none          &kp RIGHT_ARROW &none         &kp D        &kp M        &kp J    &kp B    &kp RSHFT
&none  &none  &none  &lt 1 BSPC  &none  &mt LCTRL RET      &mkp MCLK   &mt RCTRL TAB  &lt 2 SPACE  &none  &none  &none
            >;

            display-name = "ONISHI";
        };

        layer1_math {
            // layer_math 相当
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N1  &kp N2  &kp N3  &trans  &none           &trans  &none   &kp EQUAL &kp LT  &kp UNDER &kp GT  &trans
&kp PLUS &kp N0 &mt LGUI N4 &mt LALT N5 &mt LSHFT N6 &kp DOT &trans     &kp LS(INT1) &mt RSHFT COLON &mt RALT MINUS &mt RGUI DQT &kp FSLH &kp PRCNT
&trans  &kp DLLR &kp N7 &kp N8 &kp N9 &trans           &trans  &trans  &kp EXCL &kp QMARK &kp SQT &kp SEMI &trans
&none  &none  &none  &none  &none  &trans      &trans   &trans  &lt 3 SPACE  &none  &none  &none
            >;

            display-name = "MATH";
        };

        layer2_navi {
            // layer_navi 相当
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp RBKT &kp AT &kp NUHS &kp CARET &none         &trans  &none   &kp C_VOL_UP &kp ESC &kp UP &kp LS(CAPS) &trans
&kp LBKT &kp HASH &mt LGUI STAR &mt LALT AMPS &mt LSHFT LPAR &kp LS(INT3) &trans &kp C_VOL_DN &kp LEFT &kp DOWN &kp RIGHT &kp C_BRI_UP &kp PSCRN
&trans  &kp INT1 &kp RBRC &kp LBRC &kp TILDE2 &trans     &trans  &trans  &kp C_PREV &kp C_PP &kp C_NEXT &kp C_BRI_DN &trans
&none  &none  &none  &lt 3 BSPC  &none  &trans      &trans   &trans  &none  &none  &none  &none
            >;

            display-name = "NAVI";
        };

        layer3_system {
            // layer_system 相当
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 4 &bt BT_CLR &bt BT_CLR_ALL &out OUT_TOG &none  &trans  &none   &kp INS &kp HOME &kp PG_UP &none &trans
&kp F1  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &kp F6 &trans &kp F7 &kp DEL &kp END &kp PG_DN &kp K_APP &kp F12
&trans  &kp F2  &kp F3  &kp F4  &kp F5  &trans          &trans  &trans  &kp F8  &kp F9  &kp F10  &kp F11  &trans
&none  &none  &none  &none  &none  &trans      &trans   &trans  &none  &none  &none  &none
            >;

            display-name = "SYSTEM";
        };
    };
};
