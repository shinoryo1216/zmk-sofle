#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

// 親指行の&lt（レイヤータップ）挙動を調整。
// balancedでも改善しなかったため、tap-preferredに変更。
// tap-preferredは「そのキー自体をtapping-term-ms以上押し続けたか」だけで判定するため、
// 別のキーが割り込んでもホールド誤判定が起きにくい。
&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

// 親指行のENTER/SPACE/BSPCは特にタップ頻度が高く、200msだと
// 通常のタイピング速度でもホールドと誤判定されやすいため、
// 専用のlt_thumbビヘイビアを用意してtapping-term-msを280msに緩和。
// ※require-prior-idle-msは一度試したが撤去。「直前のキー入力からの
// 経過時間」だけで判定するため、タイピング直後に意図的に長押しして
// 記号レイヤーへ切り替えようとした場合まで強制的にタップ扱いになり、
// レイヤー切替に引っかかりが出る副作用があったため。
// 同一キーの「連打」対策はquick-tap-msで対応（直前に同じキーがタップ
// 確定した直後の再押下は、押している時間に関わらずタップ扱いになる）。
// 200ms→175msでは連打時に弾かれるケースがあったため200msに緩和。
//
// ※flavorはtap-preferred→balancedに変更。
// tap-preferredは「割り込みキーが来てもホールドキー自身がtapping-term-ms
// (280ms)を超えるまでホールド確定しない」ため、記号レイヤーを親指キーで
// ホールドしたまま記号キーを押しても、その記号キーの入力自体が最大280ms
// 遅延して送信され、これが「記号入力時の引っかかり」の原因だった。
// balancedは「割り込みキーが押されて、かつそのキーが離された時点」で
// ホールドを確定するため、記号キーをタップした瞬間（通常100ms未満）で
// ホールドが確定し、レイヤー切替の体感遅延がほぼ無くなる。
// 一方、割り込みキーが無い単独タップ（＝連打）はflavorに関係なく
// tapping-term-ms/quick-tap-msだけで判定されるため、この変更で連打の
// 誤ホールド対策が後退することはない。
// PSCRN/DEL/ESC（&ltのまま）は使用頻度が低くレイヤーホールド用途が
// 主なので200ms・tap-preferredのまま据え置き。
/ {
    behaviors {
        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };
};

// SPACEだけは別ビヘイビア（lt_thumb_space）に分離。
// ENTER/BSPCのホールドは基本「単独で長押しして連続削除」等、単独タップの
// 連打が中心だが、SPACEのホールドは「記号レイヤーに入って“次に押す”記号
// キーと組み合わせる」というチョード（同時押し）利用が主目的。
// balanced/tap-preferredは「割り込みキーが押されてから離されるまで」を
// 待ってからホールド確定するため、記号キー自体の押下時間ぶんの遅延が
// 残ってしまう。SPACEに関してはこの遅延そのものが「引っかかり」として
// 一番体感されやすいため、flavor=hold-preferredにして「割り込みキーが
// “押された”瞬間」に即ホールド確定させ、遅延をほぼゼロにする。
// トレードオフ：単語間でSPACEを打ってすぐ次の文字を打つ際、指が
// わずかに重なる（ロールオーバー）と誤ホールドする可能性が
// ENTER/BSPCより上がる。体感で気になる場合は次の一手として
// tapping-term-msを下げる（220ms程度）か、balancedに戻すことを検討。
/ {
    behaviors {
        lt_thumb_space: lt_thumb_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp DOWN_ARROW>, <&kp UP_ARROW>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_cursor_ud: rsr_cursor_ud {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp DOWN_ARROW>;
            ccw-binding = <&kp UP_ARROW>;
        };

        rsr_cursor_lr: rsr_cursor_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp RIGHT_ARROW>;
            ccw-binding = <&kp LEFT_ARROW>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        // Layer0の r3(,)/r4(.) にあったShift+←/→を1列右（r4/r5）へ移動。
        // mm_dot: 通常タップ=ピリオド／Shift併用タップ=Shift+←
        mm_dot: mm_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mm_fslh: 通常タップ=Shift+/（"?"、従来通り常時シフト）／Shift併用タップ=Shift+→
        mm_fslh: mm_fslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(FSLH)>, <&kp LS(RIGHT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ジョイスティック押し込み：単発タップ=左クリック、素早く2回タップ=右クリック
        // tapping-term-msを大きめにして「判定がシビアすぎる」問題を緩和
        td_joystick_click: td_joystick_click {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mkp LCLK>, <&mkp RCLK>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ---- Layer0・Layer1(大西配列)共通コンボ ----
         * require-prior-idle-msを追加：直前の（コンボと無関係な）キー入力から
         * 150ms以内にコンボのキーが押された場合は発火しない。高速タイピング中に
         * D+F/C+V/E+R（特に左手側）が意図せず同時押し判定されてしまう問題への対策。
         * 同じ理由で右手側（J+K/M+,/U+I）にも念のため統一して適用。
         * ※150→125msに緩和。Backspace（M+,/C+V）等は「誤字を打った直後」に
         * 押すことが多く、まさにその状況が「直前のキー入力から間もない」に
         * 該当してコンボ自体が抑制され、稀に発動しない原因になっていたため。
         */

        combo_enter_jkl {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <34 35>;
            bindings = <&kp ENTER>;
            layers = <0 1>;
        };

        combo_enter_sdf {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <29 30>;
            bindings = <&kp ENTER>;
            layers = <0 1>;
        };

        combo_bspc_mcommadot {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <47 48>;
            bindings = <&kp BSPC>;
            layers = <0 1>;
        };

        combo_bspc_xcv {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <42 43>;
            bindings = <&kp BSPC>;
            layers = <0 1>;
        };

        combo_hankaku_uio {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <21 22>;
            bindings = <&kp GRAVE>;
            layers = <0 1>;
        };

        combo_hankaku_wer {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <16 17>;
            bindings = <&kp GRAVE>;
            layers = <0 1>;
        };

        /* Gboard（iPadで使用）は物理キーボードの言語切替にShift+Spaceという
         * 独自ショートカットを使う。BT接続先やレイヤーに応じて中身を変える
         * 案は、有線接続に自動で切り替わった際にレイヤーが追従せず不整合が
         * 起きる問題があるため破棄。4+5・6+7はどの接続先でも常に単純に
         * Shift+Spaceを送るだけにする。
         * ※macOSのLANG1(かな)/LANG2(英数)は使わない方針に変更。Shift+Space
         * はmacOS上ではIME切替ではなく単なる半角スペース入力になる点に注意。 */
        combo_ime_japanese {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp LS(SPACE)>;
            layers = <0 1>;
        };

        combo_ime_english {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp LS(SPACE)>;
            layers = <0 1>;
        };

        /* ---- ウィンドウ管理コンボ（新Layer5=ウィンドウ管理レイヤー） ---- */

        combo_l2_mb4_mcomma {
            timeout-ms = <50>;
            key-positions = <47 48>;
            bindings = <&mkp MB4>;
            layers = <5>;
        };

        combo_l2_mb4_cx {
            timeout-ms = <50>;
            key-positions = <41 42>;
            bindings = <&mkp MB4>;
            layers = <5>;
        };

        combo_l2_mb5_commadot {
            timeout-ms = <50>;
            key-positions = <48 49>;
            bindings = <&mkp MB5>;
            layers = <5>;
        };

        combo_l2_mb5_cv {
            timeout-ms = <50>;
            key-positions = <42 43>;
            bindings = <&mkp MB5>;
            layers = <5>;
        };

        combo_l2_maximize_ui {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp LG(W)>;
            layers = <4 5>;
        };

        combo_l2_maximize_er {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LG(W)>;
            layers = <4 5>;
        };

        combo_l2_close_io {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp LG(C)>;
            layers = <4 5>;
        };

        combo_l2_close_we {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LG(C)>;
            layers = <4 5>;
        };

        combo_l2_mission_jkl {
            timeout-ms = <50>;
            key-positions = <34 35 36>;
            bindings = <&kp LG(TAB)>;
            layers = <5>;
        };

        combo_l2_mission_sdf {
            timeout-ms = <50>;
            key-positions = <28 29 30>;
            bindings = <&kp LG(TAB)>;
            layers = <5>;
        };

        /* ---- Layer6専用コンボ（マウスレイヤー） ---- */

        combo_l4_lclk_ui {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&mkp LCLK>;
            layers = <6>;
        };

        combo_l4_lclk_er {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&mkp LCLK>;
            layers = <6>;
        };

        combo_l4_mclk_uio {
            timeout-ms = <50>;
            key-positions = <21 22 23>;
            bindings = <&mkp MCLK>;
            layers = <6>;
        };

        combo_l4_mclk_wer {
            timeout-ms = <50>;
            key-positions = <15 16 17>;
            bindings = <&mkp MCLK>;
            layers = <6>;
        };

        combo_l4_rclk_io {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&mkp RCLK>;
            layers = <6>;
        };

        combo_l4_rclk_we {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mkp RCLK>;
            layers = <6>;
        };

        /* ---- レイヤー切替用コンボ（全レイヤー共通） ---- */

        combo_mo5_left {
            timeout-ms = <50>;
            key-positions = <56 57>;
            bindings = <&mo 7>;
        };

        combo_mo5_right {
            timeout-ms = <50>;
            key-positions = <59 60>;
            bindings = <&mo 7>;
        };

        combo_layer6_left {
            timeout-ms = <150>;
            key-positions = <53 54 55 56 57>;
            bindings = <&mo 8>;
        };

        combo_layer6_right {
            timeout-ms = <150>;
            key-positions = <59 60 61 62 63>;
            bindings = <&mo 8>;
        };

        /* ---- System B（大西配列）切替コンボ ---- */

        combo_onishi_toggle {
            timeout-ms = <50>;
            key-positions = <53 54 62 63>;
            bindings = <&tog 1>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };

        // 半角/全角キーはGRAVE単体（Windows/Linuxで動作確認済み）。
        // macOS/iPadOSではLANG2を使う必要があるが、LANG2は「英数固定」でトグルにならないため見送り。
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp MINUS
&kp TAB     &kp Q      &kp W         &kp E         &kp R         &kp T        &kp DOWN_ARROW   &kp Y      &kp U         &kp I         &kp O      &kp P       &kp LBKT
&kp LCTRL   &kp A      &kp S         &kp D         &kp F         &kp G        &kp LEFT_ARROW   &kp H      &kp J         &kp K         &kp L      &kp SEMI    &kp SQT
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V         &kp B        &kp RIGHT_ARROW  &kp N      &kp M         &kp COMMA     &mm_dot    &mm_fslh     &kp RSHFT
&tog 9  &kp LALT   &lt 6 PSCRN   &lt_thumb 4 BSPC    &lt_thumb_space 2 SPACE   &lt_thumb 5 ENTER  &td_joystick_click        &lt_thumb 5 ENTER &lt_thumb_space 2 SPACE  &lt_thumb 4 BSPC    &lt 6 DEL  &lt 6 ESC
            >;

            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L0 BASE";
        };

        layer_8_onishi {
            // System B：大西配列 新Layer0（レイヤー番号1）
            // SPACE/L1のみ Layer3（大西配列専用の記号レイヤー）を指す。他はLayer0と全く同じ共有レイヤーを指す
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &none
&kp TAB     &kp Q      &kp L         &kp U         &kp F         &kp GRAVE    &kp DOWN_ARROW   &kp GRAVE  &kp W         &kp R         &kp Y      &kp P       &none
&kp LCTRL   &kp E      &kp I         &kp A         &kp O         &kp MINUS    &kp LEFT_ARROW   &kp K      &kp T         &kp N         &kp S      &kp H       &none
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V         &kp COMMA    &kp RIGHT_ARROW  &kp G      &kp D         &kp M         &kp J      &kp B       &kp RSHFT
&tog 9  &kp LALT   &lt 6 PSCRN   &lt_thumb 4 BSPC    &lt_thumb_space 3 SPACE   &lt_thumb 5 ENTER  &td_joystick_click        &lt_thumb 5 ENTER &lt_thumb_space 3 SPACE  &lt_thumb 4 BSPC    &lt 6 DEL  &lt 6 ESC
            >;

            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L1 ONISHI";
        };

        layer_1 {
            bindings = <
&kp ESC     &kp N1           &kp N2          &kp N3           &kp N4           &kp N5             &kp UP_ARROW     &kp N6           &kp N7           &kp N8      &kp N9     &kp N0            &kp MINUS
&kp TAB     &none            &none           &none            &none            &none              &kp DOWN_ARROW   &kp LS(RBKT)     &kp LS(BSLH)     &kp RBKT    &kp BSLH   &kp LS(LBKT)      &kp LS(INT3)
&kp LCTRL   &kp LS(N1)       &kp LS(N2)      &kp LS(N3)       &kp LS(N4)       &kp LS(N5)         &kp LEFT_ARROW   &kp LS(N6)       &kp LS(N7)       &kp LS(N8)  &kp LS(N9) &kp EQUAL         &kp LS(EQUAL)
&kp LSHFT   &kp LS(SQT)      &kp LS(SEMI)    &kp MINUS        &kp FSLH         &kp LS(MINUS)      &kp RIGHT_ARROW  &kp LS(INT1)     &kp INT3         &kp LS(COMMA) &kp LS(DOT) &kp FSLH      &kp INT1
&tog 9  &kp LALT         &lt 6 PSCRN     &lt_thumb 4 BSPC       &lt_thumb_space 2 SPACE      &lt_thumb 5 ENTER        &mkp MCLK        &lt_thumb 5 ENTER      &lt_thumb_space 2 SPACE      &lt_thumb 4 BSPC  &lt 6 DEL  &lt 6 ESC
            >;

            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L2 SYMBOL";
        };

        layer_9_onishi_symbol {
            // System B：大西配列 新Layer1（記号）※Layer1(ONISHI)のSPACE/L3ホールドでアクセス
            // 透過(&trans)ではなく、ONISHIレイヤーで実際に出力される値を明示的に指定
            // ※行4 L4の「`」はGRAVEキーコードではなくLS(LBKT)を使用。このLinux環境では
            // GRAVEキーコード自体が日本語/英語入力切替のショートカットとして割り当てられて
            // いるため（半角/全角コンボがGRAVEで動作するのもこれを利用しているため）、
            // 素のGRAVEを送ると文字ではなく言語切替が発動してしまう。Layer2と同じ
            // LS(LBKT)方式に変更して回避している。
            bindings = <
&kp ESC   &kp N1     &kp N2    &kp N3     &kp N4     &kp N5         &kp UP_ARROW    &kp N6      &kp N7     &kp N8     &kp N9     &kp N0     &none
&kp TAB   &none      &kp LBKT  &kp DQT    &kp RBKT   &none          &kp DOWN_ARROW  &none       &kp LT     &kp EQUAL  &kp GT     &kp PIPE   &kp AT
&kp TILDE &kp HASH   &kp LPAR  &kp SQT    &kp RPAR   &kp AMPS       &kp LEFT_ARROW  &kp CARET   &kp PLUS   &kp MINUS  &kp STAR   &kp FSLH   &kp BSLH
&kp LSHFT &kp DLLR   &kp LBRC  &kp LS(LBKT)  &kp RBRC   &kp DOT        &kp RIGHT_ARROW &kp UNDER   &kp EXCL   &kp QMARK  &kp COLON  &kp SEMI   &kp PRCNT
&tog 9  &kp LALT  &lt 6 PSCRN  &lt_thumb 4 BSPC  &lt_thumb_space 3 SPACE  &lt_thumb 5 ENTER      &mkp MCLK   &lt_thumb 5 ENTER  &lt_thumb_space 3 SPACE  &lt_thumb 4 BSPC  &lt 6 DEL  &lt 6 ESC
            >;

            display-name = "L3 ONISHI SYM";
        };

        layer_2 {
            bindings = <
&kp ESC  &none    &none      &none      &none      &none      &mmv MOVE_UP     &none      &none           &none           &none           &none    &none
&kp TAB  &kp HOME  &kp PG_UP  &kp UP_ARROW &kp PG_DN  &kp END   &mmv MOVE_DOWN   &kp END   &kp PG_DN       &kp UP_ARROW    &kp PG_UP       &kp HOME  &none
&kp LCTRL &none   &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &none      &mmv MOVE_LEFT   &none      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW &none    &none
&kp LSHFT &none   &none      &none      &none      &none      &mmv MOVE_RIGHT  &none      &none           &none           &none           &none    &kp RSHFT
&tog 9         &kp LALT           &lt 6 PSCRN    &lt_thumb 4 BSPC     &lt_thumb_space 2 SPACE    &lt_thumb 5 ENTER        &mkp MCLK        &lt_thumb 5 ENTER        &lt_thumb_space 2 SPACE    &lt_thumb 4 BSPC     &lt 6 DEL      &lt 6 ESC
            >;

            display-name = "L4 CURSOR";
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
        };

        layer_3 {
            bindings = <
&kp LG(FSLH)       &none              &none          &none          &none          &kp LG(BSLH)       &mmv MOVE_UP     &kp LG(BSLH)       &none          &none          &none          &none          &kp LG(FSLH)
