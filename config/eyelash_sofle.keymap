        layer_5_onishi_symbol {
            bindings = <
&kp ESC   &kp N1     &kp N2    &kp N3     &kp N4     &kp N5              &kp LC(C)       &kp N6         &kp N7        &kp N8        &kp N9      &kp N0      &none
&kp TAB   &macro_nakaguro &kp RBKT &kp LS(N2) &kp BSLH &kp UP_ARROW      &kp LC(V)       &kp DOWN_ARROW &kp LT        &kp LS(MINUS) &kp GT      &kp LS(INT3) &none
&kp EQUAL &kp HASH   &kp LS(N8) &kp LS(N7) &kp LS(N9) &kp LS(EQUAL)      &kp LC(Z)       &kp LS(N6)     &kp LS(SEMI)  &kp MINUS     &kp LS(SQT) &kp FSLH    &kp INT1
&kp LSHFT &kp DLLR   &kp LS(RBKT) &kp LS(LBKT) &kp LS(BSLH) &kp EXCL     &kp LC(LS(Z))   &kp LS(INT1)   &kp SQT       &kp SEMI      &kp PRCNT   &kp LBKT    &kp RSHFT
&tog 14   &kp LALT   &lt 9 PSCRN &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 5 0 &kp LC(A)      &lt_thumb 5 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
