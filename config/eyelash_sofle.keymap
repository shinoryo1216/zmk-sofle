        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // ①フォールバック：L14（マーカー）単体がONなら常にLayer 12（矢印左右）。
        cl_l14 { if-layers = <14>; then-layer = <12>; };

        // ②上書き：記号レイヤー（L4, L5, L6）＋L14 → undo/redo（index 15）
        cl_l4_l14 { if-layers = <4 14>; then-layer = <15>; };
        cl_l5_l14 { if-layers = <5 14>; then-layer = <15>; };
        cl_l6_l14 { if-layers = <6 14>; then-layer = <15>; };

        // カーソルレイヤー（L7）＋L14 → browser nav（index 16）
        cl_l7_l14 { if-layers = <7 14>; then-layer = <16>; };

        // ウィンドウ管理（L8）＋L14 → tab nav（index 17）
        cl_l8_l14 { if-layers = <8 14>; then-layer = <17>; };

        // マウスレイヤー（L9）＋L14 → マウス上下（index 13）
        cl_l9_l14 { if-layers = <9 14>; then-layer = <13>; };

        // ファンクションキー（L10） / Bluetooth（L11）＋L14 → cursor ud（index 18）
        cl_l10_l14 { if-layers = <10 14>; then-layer = <18>; };
        cl_l11_l14 { if-layers = <11 14>; then-layer = <18>; };
    };
};
