&kp LCTRL &none      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &mmv MOVE_LEFT  &none          &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
&kp LSHFT &none      &none     &none      &none      &none               &mmv MOVE_RIGHT &none          &none         &none         &none       &none       &none
&tog 14   &kp LALT   &lt 9 PSCRN &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 4 0 &mkp MCLK      &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
