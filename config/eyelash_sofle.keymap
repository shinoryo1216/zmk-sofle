#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

// 親指行の&lt（レイヤータップ）挙動を調整。
// balancedでも改善しなかったため、tap-preferredに変更。
// tap-preferredは「そのキー自体をtapping-term-ms以上押し続けたか」だけで判定するため、
// 別のキーが割り込んでもホールド誤判定が起きにくい。
&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

// 親指行のENTER/SPACE/BSPCは特にタップ頻度が高く、200msだと
// 通常のタイピング速度でもホールドと誤判定されやすいため、
// 専用のlt_thumbビヘイビアを用意してtapping-term-msを280msに緩和。
// ※require-prior-idle-msは一度試したが撤去。「直前のキー入力からの
// 経過時間」だけで判定するため、タイピング直後に意図的に長押しして
// 記号レイヤーへ切り替えようとした場合まで強制的にタップ扱いになり、
// レイヤー切替に引っかかりが出る副作用があったため。
// 同一キーの「連打」対策はquick-tap-msで対応（直前に同じキーがタップ
// 確定した直後の再押下は、押している時間に関わらずタップ扱いになる）。
// 200ms→175msでは連打時に弾かれるケースがあったため200msに緩和。
//
// ※flavorはtap-preferred→balancedに変更。
// tap-preferredは「割り込みキーが来てもホールドキー自身がtapping-term-ms
// (280ms)を超えるまでホールド確定しない」ため、記号レイヤーを親指キーで
// ホールドしたまま記号キーを押しても、その記号キーの入力自体が最大280ms
// 遅延して送信され、これが「記号入力時の引っかかり」の原因だった。
// balancedは「割り込みキーが押されて、かつそのキーが離された時点」で
// ホールドを確定するため、記号キーをタップした瞬間（通常100ms未満）で
// ホールドが確定し、レイヤー切替の体感遅延がほぼ無くなる。
// 一方、割り込みキーが無い単独タップ（＝連打）はflavorに関係なく
// tapping-term-ms/quick-tap-msだけで判定されるため、この変更で連打の
// 誤ホールド対策が後退することはない。
// PSCRN/DEL/ESC（&ltのまま）は使用頻度が低くレイヤーホールド用途が
// 主なので200ms・tap-preferredのまま据え置き。
/ {
    behaviors {
        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };
};

// SPACEだけは別ビヘイビア（lt_thumb_space）に分離。
// ENTER/BSPCのホールドは基本「単独で長押しして連続削除」等、単独タップの
// 連打が中心だが、SPACEのホールドは「記号レイヤーに入って“次に押す”記号
// キーと組み合わせる」というチョード（同時押し）利用が主目的。
// balanced/tap-preferredは「割り込みキーが押されてから離されるまで」を
// 待ってからホールド確定するため、記号キー自体の押下時間ぶんの遅延が
// 残ってしまう。SPACEに関してはこの遅延そのものが「引っかかり」として
// 一番体感されやすいため、flavor=hold-preferredにして「割り込みキーが
// “押された”瞬間」に即ホールド確定させ、遅延をほぼゼロにする。
// トレードオフ：単語間でSPACEを打ってすぐ次の文字を打つ際、指が
// わずかに重なる（ロールオーバー）と誤ホールドする可能性が
// ENTER/BSPCより上がる。体感で気になる場合は次の一手として
// tapping-term-msを下げる（220ms程度）か、balancedに戻すことを検討。
/ {
    behaviors {
        lt_thumb_space: lt_thumb_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };
};

/ {
    behaviors {
        rsr_cursor_ud: rsr_cursor_ud {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp DOWN_ARROW>;
            ccw-binding = <&kp UP_ARROW>;
        };

        rsr_cursor_lr: rsr_cursor_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp RIGHT_ARROW>;
            ccw-binding = <&kp LEFT_ARROW>;
        };

        // Layer2（記号）・Layer3（大西配列専用記号）のジョイスティック/エンコーダー
        // 左右操作用。CW（右）=やり直し(Ctrl+Shift+Z)、CCW（左）=元に戻す(Ctrl+Z)。
        rsr_undo_redo: rsr_undo_redo {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LC(LS(Z))>;
            ccw-binding = <&kp LC(Z)>;
        };

        // Layer4（カーソル移動）のジョイスティック/エンコーダー左右操作用。
        // CW（右）=進む(Alt+→)、CCW（左）=戻る(Alt+←)。
        rsr_browser_nav: rsr_browser_nav {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LA(RIGHT)>;
            ccw-binding = <&kp LA(LEFT)>;
        };

        // Layer5（ウィンドウ管理）のジョイスティック/エンコーダー左右操作用。
        // CW（右）=次のタブ(Ctrl+Tab)、CCW（左）=前のタブ(Ctrl+Shift+Tab)。
        rsr_tab_nav: rsr_tab_nav {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LC(TAB)>;
            ccw-binding = <&kp LC(LS(TAB))>;
        };

        // Layer6（マウス操作）のロータリーエンコーダー用。
        // CW（右回転）=マウスポインタ右移動、CCW（左回転）=マウスポインタ左移動。
        // tap-msは短め（30ms）に設定：長いと&mmvの加速が蓄積し、素早く回した際に
        // 惰性で動き続ける（オーバーシュート）原因になるため。trigger-period-ms(16ms)は
        // 下回らない値にしておくこと（1detentあたり最低1回は移動レポートを発生させるため）。
        rsr_mouse_lr: rsr_mouse_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <30>;
            cw-binding = <&mmv MOVE_RIGHT>;
            ccw-binding = <&mmv MOVE_LEFT>;
        };

        // Layer10（L6専用・エンコーダー押し込みでトグル）のロータリーエンコーダー用。
        // CW（右回転）=マウスポインタ下移動、CCW（左回転）=マウスポインタ上移動。
        // tap-msの考え方はrsr_mouse_lrと同じ（惰性軽減のため短め）。
        rsr_mouse_ud: rsr_mouse_ud {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <30>;
            cw-binding = <&mmv MOVE_DOWN>;
            ccw-binding = <&mmv MOVE_UP>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        // Layer0の r3(,)/r4(.) にあったShift+←/→を1列右（r4/r5）へ移動。
        // mm_dot: 通常タップ=ピリオド／Shift併用タップ=Shift+←
        mm_dot: mm_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // mm_fslh: 通常タップ=Shift+/（"?"、従来通り常時シフト）／Shift併用タップ=Shift+→
        mm_fslh: mm_fslh {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(FSLH)>, <&kp LS(RIGHT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // ジョイスティック押し込み：単発タップ=左クリック、素早く2回タップ=右クリック
        // tapping-term-msを大きめにして「判定がシビアすぎる」問題を緩和
        td_joystick_click: td_joystick_click {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mkp LCLK>, <&mkp RCLK>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ---- Layer0・Layer1(大西配列)共通コンボ ----
         * require-prior-idle-msを追加：直前の（コンボと無関係な）キー入力から
         * 150ms以内にコンボのキーが押された場合は発火しない。高速タイピング中に
         * D+F/C+V/E+R（特に左手側）が意図せず同時押し判定されてしまう問題への対策。
         * 同じ理由で右手側（J+K/M+,/U+I）にも念のため統一して適用。
         * ※150→125msに緩和。Backspace（M+,/C+V）等は「誤字を打った直後」に
         * 押すことが多く、まさにその状況が「直前のキー入力から間もない」に
         * 該当してコンボ自体が抑制され、稀に発動しない原因になっていたため。
         */

        combo_enter_jkl {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <34 35>;
            bindings = <&kp ENTER>;
            layers = <0 1>;
        };

        combo_enter_sdf {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <29 30>;
            bindings = <&kp ENTER>;
            layers = <0 1>;
        };

        combo_bspc_mcommadot {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <47 48>;
            bindings = <&kp BSPC>;
            layers = <0 1>;
        };

        combo_bspc_xcv {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <42 43>;
            bindings = <&kp BSPC>;
            layers = <0 1>;
        };

        combo_hankaku_uio {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <21 22>;
            bindings = <&kp GRAVE>;
            layers = <0 1>;
        };

        combo_hankaku_wer {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <16 17>;
            bindings = <&kp GRAVE>;
            layers = <0 1>;
        };

        /* macOS/iPadOSの日本語⇔英語入力切り替え。
         * LANG1=かな(日本語IMEをON)、LANG2=英数(IMEをOFF=英語入力)。
         * Gboard向けのShift+Spaceは実機で機能しなかったため撤回し、
         * LANG1/LANG2方式に戻した。 */
        combo_ime_japanese {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp LANG1>;
            layers = <0 1>;
        };

        combo_ime_english {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp LANG2>;
            layers = <0 1>;
        };

        /* ---- ウィンドウ管理コンボ（新Layer5=ウィンドウ管理レイヤー） ---- */

        combo_l2_mb4_mcomma {
            timeout-ms = <50>;
            key-positions = <47 48>;
            bindings = <&mkp MB4>;
            layers = <5>;
        };

        combo_l2_mb4_cx {
            timeout-ms = <50>;
            key-positions = <41 42>;
            bindings = <&mkp MB4>;
            layers = <5>;
        };

        combo_l2_mb5_commadot {
            timeout-ms = <50>;
            key-positions = <48 49>;
            bindings = <&mkp MB5>;
            layers = <5>;
        };

        combo_l2_mb5_cv {
            timeout-ms = <50>;
            key-positions = <42 43>;
            bindings = <&mkp MB5>;
            layers = <5>;
        };

        combo_l2_maximize_ui {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp LG(W)>;
            layers = <4 5>;
        };

        combo_l2_maximize_er {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LG(W)>;
            layers = <4 5>;
        };

        combo_l2_close_io {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp LG(C)>;
            layers = <4 5>;
        };

        combo_l2_close_we {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LG(C)>;
            layers = <4 5>;
        };

        combo_l2_mission_jkl {
            timeout-ms = <50>;
            key-positions = <34 35 36>;
            bindings = <&kp LG(TAB)>;
            layers = <5>;
        };

        combo_l2_mission_sdf {
            timeout-ms = <50>;
            key-positions = <28 29 30>;
            bindings = <&kp LG(TAB)>;
            layers = <5>;
        };

        /* ---- Layer6専用コンボ（マウスレイヤー） ---- */

        combo_l4_lclk_ui {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&mkp LCLK>;
            layers = <6>;
        };

        combo_l4_lclk_er {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&mkp LCLK>;
            layers = <6>;
        };

        combo_l4_mclk_uio {
            timeout-ms = <50>;
            key-positions = <21 22 23>;
            bindings = <&mkp MCLK>;
            layers = <6>;
        };

        combo_l4_mclk_wer {
            timeout-ms = <50>;
            key-positions = <15 16 17>;
            bindings = <&mkp MCLK>;
            layers = <6>;
        };

        combo_l4_rclk_io {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&mkp RCLK>;
            layers = <6>;
        };

        combo_l4_rclk_we {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mkp RCLK>;
            layers = <6>;
        };

        /* ---- レイヤー切替用コンボ（全レイヤー共通） ---- */

        combo_mo5_left {
            timeout-ms = <50>;
            key-positions = <56 57>;
            bindings = <&mo 7>;
        };

        combo_mo5_right {
            timeout-ms = <50>;
            key-positions = <59 60>;
            bindings = <&mo 7>;
        };

        combo_layer6_left {
            timeout-ms = <150>;
            key-positions = <53 54 55 56 57>;
            bindings = <&mo 8>;
        };

        combo_layer6_right {
            timeout-ms = <150>;
            key-positions = <59 60 61 62 63>;
            bindings = <&mo 8>;
        };

        /* ---- System B（大西配列）切替コンボ ---- */

        combo_onishi_toggle {
            timeout-ms = <50>;
            key-positions = <53 54 62 63>;
            bindings = <&tog 1>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };

        // 半角/全角キーはGRAVE単体（Windows/Linuxで動作確認済み）。
        // macOS/iPadOSではLANG2を使う必要があるが、LANG2は「英数固定」でトグルにならないため見送り。
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp MINUS
&kp TAB     &kp Q      &kp W         &kp E         &kp R         &kp T        &kp DOWN_ARROW   &kp Y      &kp U         &kp I         &kp O      &kp P       &kp LBKT
&kp LCTRL   &kp A      &kp S         &kp D         &kp F         &kp G        &kp LEFT_ARROW   &kp H      &kp J         &kp K         &kp L      &kp SEMI    &kp SQT
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V         &kp B        &kp RIGHT_ARROW  &kp N      &kp M         &kp COMMA     &mm_dot    &mm_fslh     &kp RSHFT
&tog 11  &kp LALT   &lt 6 PSCRN   &lt_thumb 4 BSPC    &lt_thumb_space 2 SPACE   &lt_thumb 5 ENTER  &td_joystick_click        &lt_thumb 5 ENTER &lt_thumb_space 2 SPACE  &lt_thumb 4 BSPC    &lt 6 DEL  &lt 6 ESC
            >;

            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L0 BASE";
        };

        layer_8_onishi {
            // System B：大西配列 新Layer0（レイヤー番号1）
            // SPACE/L1のみ Layer3（大西配列専用の記号レイヤー）を指す。他はLayer0と全く同じ共有レイヤーを指す
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &none
&kp TAB     &kp Q      &kp L         &kp U         &kp F         &kp GRAVE    &kp DOWN_ARROW   &kp GRAVE  &kp W         &kp R         &kp Y      &kp P       &none
&kp LCTRL   &kp E      &kp I         &kp A         &kp O         &kp MINUS    &kp LEFT_ARROW   &kp K      &kp T         &kp N         &kp S      &kp H       &none
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V         &kp COMMA    &kp RIGHT_ARROW  &kp G      &kp D         &kp M         &kp J      &kp B       &kp RSHFT
&tog 11  &kp LALT   &lt 6 PSCRN   &lt_thumb 4 BSPC    &lt_thumb_space 3 SPACE   &lt_thumb 5 ENTER  &td_joystick_click        &lt_thumb 5 ENTER &lt_thumb_space 3 SPACE  &lt_thumb 4 BSPC    &lt 6 DEL  &lt 6 ESC
            >;

            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L1 ONISHI";
        };

        layer_1 {
            bindings = <
&kp ESC     &kp N1           &kp N2          &kp N3           &kp N4           &kp N5             &kp LC(C)        &kp N6           &kp N7           &kp N8      &kp N9     &kp N0            &kp MINUS
&kp TAB     &none            &none           &none            &none            &none              &kp LC(V)        &kp LS(RBKT)     &kp LS(BSLH)     &kp RBKT    &kp BSLH   &kp LS(LBKT)      &kp LS(INT3)
&kp LCTRL   &kp LS(N1)       &kp LS(N2)      &kp LS(N3)       &kp LS(N4)       &kp LS(N5)         &kp LC(Z)        &kp LS(N6)       &kp LS(N7)       &kp LS(N8)  &kp LS(N9) &kp EQUAL         &kp LS(EQUAL)
&kp LSHFT   &kp LS(SQT)      &kp LS(SEMI)    &kp MINUS        &kp FSLH         &kp LS(MINUS)      &kp LC(LS(Z))        &kp LS(INT1)     &kp INT3         &kp LS(COMMA) &kp LS(DOT) &kp FSLH      &kp INT1
&tog 11  &kp LALT         &lt 6 PSCRN     &lt_thumb 4 BSPC       &lt_thumb_space 2 SPACE      &lt_thumb 5 ENTER        &kp LC(A)        &lt_thumb 5 ENTER      &lt_thumb_space 2 SPACE      &lt_thumb 4 BSPC  &lt 6 DEL  &lt 6 ESC
            >;

            sensor-bindings = <&rsr_undo_redo &rsr_trans>;
            display-name = "L2 SYMBOL";
        };

        layer_9_onishi_symbol {
            // System B：大西配列 新Layer1（記号）※Layer1(ONISHI)のSPACE/L3ホールドでアクセス
            // 透過(&trans)ではなく、ONISHIレイヤーで実際に出力される値を明示的に指定
            // ※JISキーボード配列を前提に、Layer2（正確に入力できることを確認済み）と
            // 同じ「JIS対応キーコード」方式に全面的に書き換え済み。以前はDQT/LBRC/TILDE等の
            // 素朴なキーコードを使っていたが、これらはJIS環境では意図と異なる文字になったり
            // （例：LBKTは意図"["のはずが実際は"@"）、無変換扱いで何も入力されない
            // （TILDE）等の問題があった。
            bindings = <
&kp ESC   &kp N1     &kp N2    &kp N3     &kp N4     &kp N5              &kp LC(C)       &kp N6         &kp N7        &kp N8        &kp N9      &kp N0      &none
&kp TAB   &none      &kp RBKT  &kp LS(N2) &kp BSLH   &none               &kp LC(V)       &none          &kp LT        &kp LS(MINUS) &kp GT      &kp LS(INT3) &kp LBKT
&kp LS(EQUAL) &kp HASH &kp LS(N8) &kp LS(N7) &kp LS(N9) &kp LS(N6)       &kp LC(Z)       &kp EQUAL      &kp LS(SEMI)  &kp MINUS     &kp LS(SQT) &kp FSLH    &kp INT1
&kp LSHFT &kp DLLR   &kp LS(RBKT) &kp LS(LBKT) &kp LS(BSLH) &kp DOT      &kp LC(LS(Z))       &kp LS(INT1)   &kp EXCL      &kp QMARK     &kp SQT     &kp SEMI    &kp PRCNT
&tog 11  &kp LALT  &lt 6 PSCRN  &lt_thumb 4 BSPC  &lt_thumb_space 3 SPACE  &lt_thumb 5 ENTER      &kp LC(A)   &lt_thumb 5 ENTER  &lt_thumb_space 3 SPACE  &lt_thumb 4 BSPC  &lt 6 DEL  &lt 6 ESC
            >;

            sensor-bindings = <&rsr_undo_redo &rsr_trans>;
            display-name = "L3 ONISHI SYM";
        };

        layer_2 {
            bindings = <
&kp ESC  &none    &none      &none      &none      &none      &none     &none      &none           &none           &none           &none    &none
&kp TAB  &kp HOME  &kp PG_UP  &kp UP_ARROW &kp PG_DN  &kp END   &none   &kp END   &kp PG_DN       &kp UP_ARROW    &kp PG_UP       &kp HOME  &none
&kp LCTRL &none   &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &none      &kp LA(LEFT)   &none      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW &none    &none
&kp LSHFT &none   &none      &none      &none      &none      &kp LA(RIGHT)  &none      &none           &none           &none           &none    &kp RSHFT
&tog 11         &kp LALT           &lt 6 PSCRN    &lt_thumb 4 BSPC     &lt_thumb_space 2 SPACE    &lt_thumb 5 ENTER        &mkp MCLK        &lt_thumb 5 ENTER        &lt_thumb_space 2 SPACE    &lt_thumb 4 BSPC     &lt 6 DEL      &lt 6 ESC
            >;

            display-name = "L4 CURSOR";
            sensor-bindings = <&rsr_browser_nav &rsr_trans>;
        };

        layer_3 {
            bindings = <
&kp LG(FSLH)       &none              &none          &none          &none          &none              &none     &none              &none          &none          &none          &none          &kp LG(FSLH)
&kp LG(LS(COMMA))  &kp LG(LS(K))      &kp LG(COMMA)  &kp LG(UP)     &kp LG(DOT)    &kp LG(LS(J))      &none   &kp LG(LS(K))      &kp LG(COMMA)  &kp LG(UP)     &kp LG(DOT)    &kp LG(LS(J))  &kp LG(LS(COMMA))
&kp LG(LS(DOT))    &kp LG(K)          &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(RIGHT)  &kp LG(J)          &kp LC(LS(TAB))   &kp LG(K)          &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(RIGHT)  &kp LG(J)      &kp LG(LS(DOT))
&kp LG(M)          &kp LG(R)          &kp LG(B)      &kp LG(ENTER)  &kp LG(E)      &kp LG(SPACE)      &kp LC(TAB)  &kp LG(SPACE)      &kp LG(E)      &kp LG(ENTER)  &kp LG(B)      &kp LG(R)      &kp LG(M)
&tog 11 &kp LALT &lt 6 PSCRN &lt_thumb 4 BSPC &lt_thumb_space 2 SPACE &lt_thumb 5 ENTER &mkp MCLK      &lt_thumb 5 ENTER &lt_thumb_space 2 SPACE    &lt_thumb 4 BSPC      &lt 6 DEL         &lt 6 ESC
            >;

            display-name = "L5 WINDOW";
            sensor-bindings = <&rsr_tab_nav &rsr_trans>;
        };

        layer_4 {
            bindings = <
&kp ESC  &none    &none      &none      &none      &none      &mmv MOVE_UP     &none      &none           &none           &none           &none    &none
&kp TAB  &kp HOME  &kp PG_UP  &mmv MOVE_UP &kp PG_DN  &kp END   &mmv MOVE_DOWN   &kp END   &kp PG_DN       &mmv MOVE_UP    &kp PG_UP       &kp HOME  &none
&kp LCTRL &none   &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none      &mmv MOVE_LEFT   &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT &none    &none
&kp LSHFT &none   &none      &none      &none      &none      &mmv MOVE_RIGHT  &none      &none           &none           &none           &none    &none
&tog 11 &kp LALT &lt 6 PSCRN &lt_thumb 4 BSPC &lt_thumb_space 2 SPACE &lt_thumb 5 ENTER &mkp MCLK      &lt_thumb 5 ENTER &lt_thumb_space 2 SPACE    &lt_thumb 4 BSPC      &lt 6 DEL         &lt 6 ESC
            >;

            display-name = "L6 MOUSE";
            sensor-bindings = <&rsr_mouse_lr &rsr_trans>;
        };

        layer_5 {
            bindings = <
&kp ESC  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp UP_ARROW  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10 &none
&kp TAB  &kp F11 &kp F12 &none   &none   &none     &kp DOWN_ARROW &none   &none   &none   &none   &none   &none
&kp LCTRL &none  &none   &none   &none   &none     &kp LEFT_ARROW &none   &none   &none   &none   &none   &none
&kp LSHFT &none  &none   &none   &none   &none     &kp RIGHT_ARROW &none  &none   &none   &none   &none   &none
&tog 11 &kp LALT &lt 6 PSCRN &lt_thumb 4 BSPC &lt_thumb_space 2 SPACE &lt_thumb 5 ENTER &mkp MCLK &lt_thumb 5 ENTER &lt_thumb_space 2 SPACE &lt_thumb 4 BSPC &lt 6 DEL &lt 6 ESC
            >;
 
            display-name = "L7 FKEYS";
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
        };

        layer_6 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp UP_ARROW  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&bootloader &none         &none         &none         &none         &none         &kp DOWN_ARROW &none         &none         &none         &none         &none         &bootloader
&none       &none         &none         &none         &none         &none         &kp LEFT_ARROW &none         &none         &none         &none         &none         &none
&none       &none         &none         &none         &none         &none         &kp RIGHT_ARROW &none        &none         &none         &none         &none         &none
&tog 11  &kp LALT      &lt 6 PSCRN   &lt_thumb 4 BSPC    &lt_thumb_space 2 SPACE   &lt_thumb 5 ENTER   &mkp MCLK     &lt_thumb 5 ENTER   &lt_thumb_space 2 SPACE   &lt_thumb 4 BSPC    &lt 6 DEL     &lt 6 ESC
            >;

            display-name = "L8 BLUETOOTH";
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
        };

        layer_7 {
            // 矢印左右モードのオーバーライドレイヤー。
            // 直接トグルするのではなく、下のconditional_layersによって
            // 「Layer0〜5・7・8のいずれか＋Layer11（エンコーダー押し込みマーカー）が両方アクティブな時だけ」
            // 自動的に有効化される（Layer6の時だけLayer10が有効化されるので対象外）。
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "L9 ENCODER LR";
            sensor-bindings = <&rsr_cursor_lr &rsr_trans>;
        };

        layer_10 {
            // Layer6（マウス操作）用のオーバーライドレイヤー。
            // 直接トグルするのではなく、下のconditional_layersによって
            // 「Layer6とLayer11（エンコーダー押し込みマーカー）が両方アクティブな時だけ」自動的に有効化される。
            // エンコーダーの回転をマウス左右（rsr_mouse_lr）からマウス上下（rsr_mouse_ud）に切り替える。
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "L10 MOUSE ENC UD";
            sensor-bindings = <&rsr_mouse_ud &rsr_trans>;
        };

        layer_11 {
            // エンコーダー押し込みマーカーレイヤー。単体では何もしない（全キー透過・センサーも透過）。
            // 全レイヤーの親指行L1（&tog 11）でこのレイヤーをON/OFFする。
            // 実際の効果は下のconditional_layersが「このレイヤー＋現在のベースレイヤー」の組み合わせを見て、
            // Layer9（多くのベースレイヤー用：矢印左右）またはLayer10（Layer6用：マウス上下）を自動的に有効化することで発生する。
            // ベースレイヤーを切り替えると、この組み合わせ判定も自動的に更新されるため、
            // マーカーをONにしたまま別レイヤーへ移動しても、移動先レイヤーに応じたオーバーライドへ自動で切り替わる。
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "L11 ENCODER PUSH MARKER";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // ベースレイヤー0(L0 BASE)＋マーカー(L11) → Layer9（矢印左右モード）
        cl_l0_l11 { if-layers = <0 11>; then-layer = <9>; };
        // ベースレイヤー1(L1 ONISHI)＋マーカー(L11) → Layer9
        cl_l1_l11 { if-layers = <1 11>; then-layer = <9>; };
        // ベースレイヤー2(L2 SYMBOL)＋マーカー(L11) → Layer9
        cl_l2_l11 { if-layers = <2 11>; then-layer = <9>; };
        // ベースレイヤー3(L3 ONISHI SYM)＋マーカー(L11) → Layer9
        cl_l3_l11 { if-layers = <3 11>; then-layer = <9>; };
        // ベースレイヤー4(L4 CURSOR)＋マーカー(L11) → Layer9
        cl_l4_l11 { if-layers = <4 11>; then-layer = <9>; };
        // ベースレイヤー5(L5 WINDOW)＋マーカー(L11) → Layer9
        cl_l5_l11 { if-layers = <5 11>; then-layer = <9>; };
        // ベースレイヤー6(L6 MOUSE)＋マーカー(L11) → Layer10（マウス上下モード。L6だけ例外）
        cl_l6_l11 { if-layers = <6 11>; then-layer = <10>; };
        // ベースレイヤー7(L7 FKEYS)＋マーカー(L11) → Layer9
        cl_l7_l11 { if-layers = <7 11>; then-layer = <9>; };
        // ベースレイヤー8(L8 BLUETOOTH)＋マーカー(L11) → Layer9
        cl_l8_l11 { if-layers = <8 11>; then-layer = <9>; };
    };
};
