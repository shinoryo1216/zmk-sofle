// ZMK_POINTING_DEFAULT_MOVE_VAL：調整履歴 1200→600→150→300→600。
#define ZMK_POINTING_DEFAULT_MOVE_VAL 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/naginata.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

// zip_xy_scaler
&mmv_input_listener { input-processors = <&zip_xy_scaler 1 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

/ {
    vel_move_x_listener: vel_move_x_listener {
        compatible = "zmk,input-listener";
        device = <&vel_move_x>;
    };
    vel_move_y_listener: vel_move_y_listener {
        compatible = "zmk,input-listener";
        device = <&vel_move_y>;
    };
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <80>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        // Home row mods
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44>;
            hold-trigger-on-release;
        };

        lt_thumb_space: lt_thumb_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_thumb_comma: lt_thumb_comma {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&mm_thumb_comma>;
        };

        lt_thumb_dot2: lt_thumb_dot2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&mm_thumb_dot>;
        };

        rsr_cursor_ud: rsr_cursor_ud {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp DOWN_ARROW>;
            ccw-binding = <&kp UP_ARROW>;
        };

        rsr_cursor_lr: rsr_cursor_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp RIGHT_ARROW>;
            ccw-binding = <&kp LEFT_ARROW>;
        };

        rsr_undo_redo: rsr_undo_redo {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LC(LS(Z))>;
            ccw-binding = <&kp LC(Z)>;
        };

        rsr_browser_nav: rsr_browser_nav {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LA(RIGHT)>;
            ccw-binding = <&kp LA(LEFT)>;
        };

        rsr_tab_nav: rsr_tab_nav {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LC(TAB)>;
            ccw-binding = <&kp LC(LS(TAB))>;
        };

        vel_move_x: vel_move_x {
            compatible = "zmk,behavior-velocity-mouse-move";
            #binding-cells = <1>;
            input-code = <INPUT_REL_X>;
            min-move = <8>;
            max-move = <28>;
            min-interval-ms = <8>;
            max-interval-ms = <120>;
        };

        vel_move_y: vel_move_y {
            compatible = "zmk,behavior-velocity-mouse-move";
            #binding-cells = <1>;
            input-code = <INPUT_REL_Y>;
            min-move = <8>;
            max-move = <28>;
            min-interval-ms = <8>;
            max-interval-ms = <120>;
        };

        mouse_rot_lr: mouse_rot_lr {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&vel_move_x 1>, <&vel_move_x (-1)>;
        };

        mouse_rot_ud: mouse_rot_ud {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&vel_move_y 1>, <&vel_move_y (-1)>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        mm_row_comma: mm_row_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_dot: mm_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(RIGHT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_thumb_comma: mm_thumb_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_thumb_dot: mm_thumb_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(RIGHT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td_joystick_click: td_joystick_click {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mkp LCLK>, <&mkp RCLK>;
        };
    };

    macros {
        macro_nn: macro_nn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X>, <&kp N>;
            label = "MACRO_NN";
        };

        macro_nakaguro: macro_nakaguro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z>, <&kp FSLH>;
            label = "MACRO_NAKAGURO";
        };

        // システム③（Colemak ⇔ 薙刀式）切替マクロ：Windows/Linux用（半角/全角 GRAVE）
        macro_to_ng_winlin: macro_to_ng_winlin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp GRAVE>, <&macro_tap &to 3>;
            label = "MACRO_TO_NG_WINLIN";
        };

        macro_to_colemak_winlin: macro_to_colemak_winlin {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp GRAVE>, <&macro_tap &to 2>;
            label = "MACRO_TO_COLEMAK_WINLIN";
        };

        // システム③（Colemak ⇔ 薙刀式）切替マクロ：iPadOS/macOS用（LANG1/LANG2）
        macro_to_ng_ipad: macro_to_ng_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp LANG1>, <&macro_tap &to 3>;
            label = "MACRO_TO_NG_IPAD";
        };

        macro_to_colemak_ipad: macro_to_colemak_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp LANG2>, <&macro_tap &to 2>;
            label = "MACRO_TO_COLEMAK_IPAD";
        };

        // システム直接切替マクロ
        macro_to_system1: macro_to_system1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &to 0>;
            label = "MACRO_TO_SYS1";
        };

        macro_to_system2: macro_to_system2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &to 1>;
            label = "MACRO_TO_SYS2";
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ---- システム直接切替コンボ（親指2キー＋数字1/2/3） ---- */
        // システム①（QWERTY）へ切替
        combo_sys1_left {
            timeout-ms = <60>;
            key-positions = <53 54 1>; // L2+L3+1
            bindings = <&macro_to_system1>;
            layers = <0 1 2 3>;
        };
        combo_sys1_right {
            timeout-ms = <60>;
            key-positions = <62 63 1>; // R4+R5+1
            bindings = <&macro_to_system1>;
            layers = <0 1 2 3>;
        };

        // システム②（大西配列）へ切替
        combo_sys2_left {
            timeout-ms = <60>;
            key-positions = <53 54 2>; // L2+L3+2
            bindings = <&macro_to_system2>;
            layers = <0 1 2 3>;
        };
        combo_sys2_right {
            timeout-ms = <60>;
            key-positions = <62 63 2>; // R4+R5+2
            bindings = <&macro_to_system2>;
            layers = <0 1 2 3>;
        };

        // システム③（Colemak＋薙刀式）へ切替
        combo_sys3_left {
            timeout-ms = <60>;
            key-positions = <53 54 3>; // L2+L3+3
            bindings = <&macro_to_colemak_winlin>;
            layers = <0 1 2 3>;
        };
        combo_sys3_right {
            timeout-ms = <60>;
            key-positions = <62 63 3>; // R4+R5+3
            bindings = <&macro_to_colemak_winlin>;
            layers = <0 1 2 3>;
        };

        /* ---- システム③（Colemak ⇔ 薙刀式）言語・レイヤー切替コンボ ---- */
        // Windows/Linux用: U+I / E+R (GRAVE + レイヤー切替)
        combo_colemak_to_ng_ui {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <21 22>; // U+I
            bindings = <&macro_to_ng_winlin>;
            layers = <2>;
        };
        combo_colemak_to_ng_er {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <16 17>; // E+R
            bindings = <&macro_to_ng_winlin>;
            layers = <2>;
        };
        combo_ng_to_colemak_ui {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <21 22>; // U+I
            bindings = <&macro_to_colemak_winlin>;
            layers = <3>;
        };
        combo_ng_to_colemak_er {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <16 17>; // E+R
            bindings = <&macro_to_colemak_winlin>;
            layers = <3>;
        };

        // iPadOS/macOS用: 4+5 / 6+7 (LANG1/LANG2 + レイヤー切替)
        combo_colemak_to_ng_ipad {
            timeout-ms = <50>;
            key-positions = <4 5>; // 4+5
            bindings = <&macro_to_ng_ipad>;
            layers = <2>;
        };
        combo_ng_to_colemak_ipad {
            timeout-ms = <50>;
            key-positions = <7 8>; // 6+7
            bindings = <&macro_to_colemak_ipad>;
            layers = <3>;
        };

        /* ---- システム①・② 共通コンボ ---- */
        combo_space_jkl {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <34 35>;
            bindings = <&kp SPACE>;
            layers = <0 1 2>;
        };

        combo_space_sdf {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <29 30>;
            bindings = <&kp SPACE>;
            layers = <0 1 2>;
        };

        combo_bspc_mcommadot {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <47 48>;
            bindings = <&kp BSPC>;
            layers = <0 1 2>;
        };

        combo_bspc_xcv {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <42 43>;
            bindings = <&kp BSPC>;
            layers = <0 1 2>;
        };

        combo_hankaku_uio {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <21 22>;
            bindings = <&kp GRAVE>;
            layers = <0 1>;
        };

        combo_hankaku_wer {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <16 17>;
            bindings = <&kp GRAVE>;
            layers = <0 1>;
        };

        combo_ime_japanese {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp LANG1>;
            layers = <0 1>;
        };

        combo_ime_english {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp LANG2>;
            layers = <0 1>;
        };

        /* ---- Layer 1（大西配列）専用コンボ ---- */
        combo_onishi_nn {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <35 36>;
            bindings = <&macro_nn>;
            layers = <1>;
        };

        combo_onishi_hankaku {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <31 33>;
            bindings = <&kp GRAVE>;
            layers = <1>;
        };

        /* ---- ウィンドウ管理コンボ（Layer 8=旧L5） ---- */
        combo_l8_mb4_mcomma {
            timeout-ms = <50>;
            key-positions = <47 48>;
            bindings = <&mkp MB4>;
            layers = <8>;
        };

        combo_l8_mb4_cx {
            timeout-ms = <50>;
            key-positions = <41 42>;
            bindings = <&mkp MB4>;
            layers = <8>;
        };

        combo_l8_mb5_commadot {
            timeout-ms = <50>;
            key-positions = <48 49>;
            bindings = <&mkp MB5>;
            layers = <8>;
        };

        combo_l8_mb5_cv {
            timeout-ms = <50>;
            key-positions = <42 43>;
            bindings = <&mkp MB5>;
            layers = <8>;
        };

        combo_l8_maximize_ui {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&kp LG(W)>;
            layers = <7 8>;
        };

        combo_l8_maximize_er {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LG(W)>;
            layers = <7 8>;
        };

        combo_l8_close_io {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&kp LG(C)>;
            layers = <7 8>;
        };

        combo_l8_close_we {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&kp LG(C)>;
            layers = <7 8>;
        };

        combo_l8_mission_jkl {
            timeout-ms = <50>;
            key-positions = <34 35 36>;
            bindings = <&kp LG(TAB)>;
            layers = <8>;
        };

        combo_l8_mission_sdf {
            timeout-ms = <50>;
            key-positions = <28 29 30>;
            bindings = <&kp LG(TAB)>;
            layers = <8>;
        };

        /* ---- Layer 9（マウスレイヤー=旧L6）専用コンボ ---- */
        combo_l9_lclk_ui {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&mkp LCLK>;
            layers = <9>;
        };

        combo_l9_lclk_er {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&mkp LCLK>;
            layers = <9>;
        };

        combo_l9_mclk_uio {
            timeout-ms = <50>;
            key-positions = <21 22 23>;
            bindings = <&mkp MCLK>;
            layers = <9>;
        };

        combo_l9_mclk_wer {
            timeout-ms = <50>;
            key-positions = <15 16 17>;
            bindings = <&mkp MCLK>;
            layers = <9>;
        };

        combo_l9_rclk_io {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&mkp RCLK>;
            layers = <9>;
        };

        combo_l9_rclk_we {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mkp RCLK>;
            layers = <9>;
        };

        /* ---- レイヤー切替用親指コンボ（全レイヤー共通） ---- */
        combo_mo_fkeys_left {
            timeout-ms = <50>;
            key-positions = <56 57>;
            bindings = <&mo 10>;
        };

        combo_mo_fkeys_right {
            timeout-ms = <50>;
            key-positions = <59 60>;
            bindings = <&mo 10>;
        };

        combo_mo_bt_left {
            timeout-ms = <150>;
            key-positions = <53 54 55 56 57>;
            bindings = <&mo 11>;
        };

        combo_mo_bt_right {
            timeout-ms = <150>;
            key-positions = <59 60 61 62 63>;
            bindings = <&mo 11>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: System A (QWERTY Base)
        layer_0_base {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp MINUS
&kp TAB     &kp Q      &kp W         &kp E         &kp R         &kp T        &kp DOWN_ARROW   &kp Y      &kp U         &kp I         &kp O      &kp P       &kp LBKT
&kp LCTRL   &kp A      &hml LCTRL S   &kp D         &hml LSHFT F   &kp G        &kp LEFT_ARROW   &kp H      &hmr RSHFT J   &kp K         &hmr RCTRL L   &kp SEMI    &kp SQT
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V         &kp B        &kp RIGHT_ARROW  &kp N      &kp M         &mm_row_comma     &mm_dot    &kp LS(FSLH)     &kp RSHFT
&tog 14  &kp LALT   &lt 9 PSCRN   &lt_thumb 7 BSPC    &lt_thumb_comma 8 0   &lt_thumb_dot2 4 0  &td_joystick_click        &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE  &lt_thumb 7 BSPC    &lt 9 DEL  &lt 9 ESC
            >;

            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L0 BASE";
        };

        // Layer 1: System B (Onishi Base)
        layer_1_onishi {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp BSPC
&kp TAB     &kp Q      &kp L         &kp U         &kp F         &kp LEFT_ARROW    &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp W         &kp R         &kp Y      &kp P       &kp UP_ARROW
&kp LCTRL   &kp E      &hml LCTRL I   &kp A         &hml LSHFT O   &kp MINUS    &kp LEFT_ARROW   &kp K      &hmr RSHFT T   &kp N         &hmr RCTRL S   &kp H       &kp DOWN_ARROW
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V         &kp LS(FSLH)    &kp RIGHT_ARROW  &kp G      &kp D         &kp M         &kp J      &kp B       &kp RSHFT
&tog 14  &kp LALT   &lt 9 PSCRN   &lt_thumb 7 BSPC    &lt_thumb_comma 8 0   &lt_thumb_dot2 5 0  &td_joystick_click        &lt_thumb 5 ENTER &lt_thumb_space 8 SPACE  &lt_thumb 7 BSPC    &lt 9 DEL  &lt 9 ESC
            >;

            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L1 ONISHI";
        };

        // Layer 2: System C (Colemak Mod-DH Base) [新規]
        layer_2_colemak {
            bindings = <
&kp ESC           &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp BSPC
&kp TAB           &kp Q      &kp W         &kp F         &kp P         &kp B        &kp DOWN_ARROW   &kp J      &kp L         &kp U         &kp Y      &kp SQT     &kp MINUS
&mt LCTRL LS(N8)  &kp A      &hml LCTRL R  &kp S         &hml LSHFT T  &kp G        &kp LEFT_ARROW   &kp M      &hmr RSHFT N  &kp E         &hmr RCTRL I &kp O     &mt RCTRL LS(N9)
&mt LSHFT RBKT    &kp Z      &kp X         &kp C         &kp D         &kp V        &kp RIGHT_ARROW  &kp K      &kp H         &kp COMMA     &kp DOT    &kp LS(FSLH) &mt RSHFT BSLH
&tog 14           &kp LALT   &lt 9 PSCRN   &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 6 0 &td_joystick_click &lt_thumb 6 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;

            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L2 COLEMAK";
        };

        // Layer 3: System C (Naginata Kana Base) [新規]
        layer_3_naginata {
            bindings = <
&kp ESC        &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp BSPC
&kp TAB        &ng Q      &ng W         &ng E         &ng R         &kp LEFT     &kp DOWN_ARROW   &kp RIGHT  &ng U         &ng I         &ng O      &ng P       &kp FSLH
&ng NG_L1_R3   &ng A      &ng S         &ng D         &ng F         &ng G        &kp LEFT_ARROW   &ng H      &ng J         &ng K         &ng L      &ng SEMI    &ng NG_R6_R3
&ng NG_L1_R4   &ng Z      &ng X         &ng C         &ng V         &ng B        &kp RIGHT_ARROW  &ng N      &ng M         &ng COMMA     &ng DOT    &kp LS(FSLH) &ng NG_R6_R4
&tog 14        &kp LALT   &lt 9 PSCRN   &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &ng SPACE &td_joystick_click &ng SPACE &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;

            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L3 NAGINATA";
        };

        // Layer 4: System A Symbol (旧Layer 2)
        layer_4_symbol {
