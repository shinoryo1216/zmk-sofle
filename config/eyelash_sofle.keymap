#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&kp DOWN_ARROW>, <&kp UP_ARROW>;

        tap-ms = <100>;
    };

    behaviors {
        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        /* ---- Layer0専用コンボ ---- */

        combo_hankaku_jkl {
            timeout-ms = <50>;
            key-positions = <34 35 36>;
            bindings = <&kp LANG5>;
            layers = <0>;
        };

        combo_hankaku_sdf {
            timeout-ms = <50>;
            key-positions = <28 29 30>;
            bindings = <&kp LANG5>;
            layers = <0>;
        };

        combo_lclk_nm {
            timeout-ms = <50>;
            key-positions = <46 47>;
            bindings = <&mkp LCLK>;
            layers = <0>;
        };

        combo_lclk_vb {
            timeout-ms = <50>;
            key-positions = <43 44>;
            bindings = <&mkp LCLK>;
            layers = <0>;
        };

        combo_rclk_mcomma {
            timeout-ms = <50>;
            key-positions = <47 48>;
            bindings = <&mkp RCLK>;
            layers = <0>;
        };

        combo_rclk_cv {
            timeout-ms = <50>;
            key-positions = <42 43>;
            bindings = <&mkp RCLK>;
            layers = <0>;
        };

        combo_enter_yu {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp ENTER>;
            layers = <0>;
        };

        combo_enter_rt {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp ENTER>;
            layers = <0>;
        };

        combo_bspc_jh {
            timeout-ms = <50>;
            key-positions = <33 34>;
            bindings = <&kp BSPC>;
            layers = <0>;
        };

        combo_bspc_fg {
            timeout-ms = <50>;
            key-positions = <30 31>;
            bindings = <&kp BSPC>;
            layers = <0>;
        };

        /* ---- Layer2専用コンボ ---- */

        combo_l2_maximize_nm {
            timeout-ms = <50>;
            key-positions = <46 47>;
            bindings = <&kp LG(W)>;
            layers = <2>;
        };

        combo_l2_maximize_vb {
            timeout-ms = <50>;
            key-positions = <43 44>;
            bindings = <&kp LG(W)>;
            layers = <2>;
        };

        combo_l2_close_mcomma {
            timeout-ms = <50>;
            key-positions = <47 48>;
            bindings = <&kp LG(C)>;
            layers = <2>;
        };

        combo_l2_close_cv {
            timeout-ms = <50>;
            key-positions = <42 43>;
            bindings = <&kp LG(C)>;
            layers = <2>;
        };

        combo_l2_mission_jkl {
            timeout-ms = <50>;
            key-positions = <34 35 36>;
            bindings = <&kp LG(TAB)>;
            layers = <2>;
        };

        combo_l2_mission_sdf {
            timeout-ms = <50>;
            key-positions = <28 29 30>;
            bindings = <&kp LG(TAB)>;
            layers = <2>;
        };

        combo_l2_mb4_ui {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&mkp MB4>;
            layers = <2>;
        };

        combo_l2_mb4_we {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mkp MB4>;
            layers = <2>;
        };

        combo_l2_mb5_io {
            timeout-ms = <50>;
            key-positions = <22 23>;
            bindings = <&mkp MB5>;
            layers = <2>;
        };

        combo_l2_mb5_er {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&mkp MB5>;
            layers = <2>;
        };

        /* ---- レイヤー切替用コンボ（全レイヤー共通） ---- */

        combo_mo4_left {
            timeout-ms = <50>;
            key-positions = <56 57>;
            bindings = <&mo 4>;
        };

        combo_mo4_right {
            timeout-ms = <50>;
            key-positions = <59 60>;
            bindings = <&mo 4>;
        };

        combo_layer5_left {
            timeout-ms = <150>;
            key-positions = <53 54 55 56 57>;
            bindings = <&mo 5>;
        };

        combo_layer5_right {
            timeout-ms = <150>;
            key-positions = <59 60 61 62 63>;
            bindings = <&mo 5>;
        };

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp MINUS
&kp TAB     &kp Q      &kp W         &kp E         &kp R         &kp T        &kp DOWN_ARROW   &kp Y      &kp U         &kp I         &kp O      &kp P       &kp LS(N2)
&kp LCTRL   &kp A      &kp S         &kp D         &kp F         &kp G        &kp LEFT_ARROW   &kp H      &kp J         &kp K         &kp L      &kp SEMI    &kp SQT
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V         &kp B        &kp RIGHT_ARROW  &kp N      &kp M         &kp COMMA     &kp DOT    &kp FSLH    &kp RSHFT
&kp C_MUTE  &kp LALT   &kp PSCRN     &lt 3 BSPC    &lt 2 ENTER   &lt 1 SPACE  &mkp MCLK        &lt 1 SPACE &lt 2 ENTER  &lt 3 BSPC    &kp DEL    &lt 3 ESC
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "LAYER0";
        };

        layer_1 {
            bindings = <
&trans      &trans           &trans          &trans           &trans           &trans             &kp UP_ARROW     &trans           &trans           &trans      &trans     &trans            &trans
&trans      &kp GRAVE        &mkp LCLK       &mkp MCLK        &mkp RCLK        &mkp MB4           &kp DOWN_ARROW   &kp LS(LBKT)     &kp LS(RBKT)     &kp LBKT    &kp RBKT   &kp GRAVE         &kp LS(BSLH)
&trans      &kp LS(N1)       &kp LS(SQT)     &kp LS(N3)       &kp LS(N4)       &kp LS(N5)         &kp LEFT_ARROW   &kp LS(N7)       &kp SQT          &kp LS(N9)  &kp LS(N0) &kp LS(N6)        &kp LS(GRAVE)
&trans      &kp LS(N8)       &kp LS(EQUAL)   &kp MINUS        &kp FSLH         &kp EQUAL          &kp RIGHT_ARROW  &kp LS(INT1)     &kp INT3         &kp LS(COMMA) &kp LS(DOT) &kp FSLH      &kp INT1
&trans      &trans           &trans          &trans           &trans           &trans             &mkp MCLK        &trans           &trans           &trans      &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "LAYER1";
        };

        layer_2 {
            bindings = <
&kp LG(FSLH)       &none              &none          &none          &none          &kp LG(BSLH)       &mmv MOVE_UP     &kp LG(BSLH)       &none          &none          &none          &none          &kp LG(FSLH)
&kp LG(LS(COMMA))  &kp LG(LS(K))      &kp LG(COMMA)  &kp LG(UP)     &kp LG(DOT)    &kp LG(LS(J))      &mmv MOVE_DOWN   &kp LG(LS(K))      &kp LG(COMMA)  &kp LG(UP)     &kp LG(DOT)    &kp LG(LS(J))  &kp LG(LS(COMMA))
&kp LG(LS(DOT))    &kp LG(K)          &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(RIGHT)  &kp LG(J)          &mmv MOVE_LEFT   &kp LG(K)          &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(RIGHT)  &kp LG(J)      &kp LG(LS(DOT))
&kp LG(M)          &kp LG(R)          &kp LG(E)      &kp LG(ENTER)  &kp LG(B)      &kp LG(SPACE)      &mmv MOVE_RIGHT  &kp LG(SPACE)      &kp LG(B)      &kp LG(ENTER)  &kp LG(E)      &kp LG(R)      &kp LG(M)
&trans             &trans             &trans         &trans         &trans         &trans             &trans           &trans             &trans         &trans         &trans         &trans
            >;

            display-name = "LAYER2";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            bindings = <
&trans  &none    &mkp RCLK  &mkp MCLK  &mkp LCLK  &none      &mmv MOVE_UP     &none      &mkp LCLK       &mkp MCLK       &mkp RCLK       &none    &none
&trans  &kp END  &kp PG_DN  &mmv MOVE_UP &kp PG_UP  &kp HOME   &mmv MOVE_DOWN   &kp HOME   &kp PG_UP       &mmv MOVE_UP    &kp PG_DN       &kp END  &none
&trans  &none    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none      &mmv MOVE_LEFT   &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT &none    &none
&trans  &none    &none      &none      &none      &none      &mmv MOVE_RIGHT  &none      &none           &none           &none           &none    &none
&trans  &trans   &trans     &trans     &trans     &trans     &trans           &trans     &trans          &trans          &trans          &trans
            >;

            display-name = "LAYER3";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &trans  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10 &none
&trans  &kp F11 &kp F12 &none   &none   &none     &trans  &none   &none   &none   &none   &none   &none
&trans  &none   &none   &none   &none   &none     &trans  &none   &none   &none   &none   &none   &none
&trans  &none   &none   &none   &none   &none     &trans  &none   &none   &none   &none   &none   &none
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
 
            display-name = "LAYER4";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_5 {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&bootloader &none         &none         &none         &none         &none         &trans  &none         &none         &none         &none         &none         &bootloader
&none       &none         &none         &none         &none         &none         &trans  &none         &none         &none         &none         &none         &none
&none       &none         &none         &none         &none         &none         &trans  &none         &none         &none         &none         &none         &none
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans        &trans        &trans        &trans        &trans
            >;

            display-name = "LAYER5";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
