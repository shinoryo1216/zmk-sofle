/*
 * eyelash_sofle 大西配列 実装（第一段階）
 *
 * 既存のカスタマイズ（Layer2〜7、コンボ、mod-morph等）は一旦含めていません。
 * まずは大西配列そのもの（30キーの文字割り当て＋おさかなキーボード準拠のホームロー修飾）を
 * このキーボードの物理レイアウトに正しく移植することだけを目的にしています。
 *
 * 参考:
 *  - 大西配列 公式サイト: https://o24.works/layout/
 *  - おさかなキーボード公式リポジトリ: https://github.com/TakumaOnishi/zmk-config-fish
 *
 * Layer1（記号）は本格的な頻度統計に基づく再設計がまだのため、
 * 暫定的に「同じアルファベットの位置に、おさかな本家の対応記号を置く」簡易版です。
 * 統計に基づくゼロ設計は別途相談の上、差し替えます。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/* おさかなキーボード本家準拠のホームロー修飾チューニング */
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <225>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        layer0_onishi {
            // 大西配列 本体（アルファベット・コンマ・ピリオド・ハイフン・セミコロン）
            // ＋ホームロー修飾（I=GUI, A=Alt, O=Shift / T=Shift, N=Alt, S=GUI）
            // ＋Tab/EnterはCtrl（おさかな本家準拠）
            bindings = <
&kp ESC        &kp N1   &kp N2       &kp N3       &kp N4        &kp N5          &kp UP_ARROW    &kp N6          &kp N7       &kp N8       &kp N9   &kp N0    &kp MINUS
&mt LCTRL TAB  &kp Q    &kp L        &kp U        &kp COMMA     &kp DOT         &kp DOWN_ARROW  &kp F           &kp W        &kp R        &kp Y    &kp P     &kp LBKT
&kp LCTRL      &kp E    &mt LGUI I   &mt LALT A   &mt LSHFT O   &kp MINUS       &kp LEFT_ARROW  &kp K           &mt RSHFT T  &mt RALT N   &mt RGUI S &kp H   &kp SQT
&kp LSHFT      &kp Z    &kp X        &kp C        &kp V         &kp SEMI        &kp RIGHT_ARROW &kp G           &kp D        &kp M        &kp J    &kp B     &kp RSHFT
&kp LGUI  &kp LALT  &lt 1 ESC  &kp BSPC  &kp SPACE  &mt LCTRL RET      &mkp MCLK       &mt RCTRL RET  &kp SPACE  &kp BSPC  &lt 1 ESC  &kp LALT
            >;

            display-name = "ONISHI";
        };

        layer1_symbol_provisional {
            // 暫定の記号レイヤー（大西配列の各文字の位置に、おさかな本家Fn層の対応記号を配置）
            // ※頻度統計に基づく正式設計はまだ。実用のための仮置きです。
            bindings = <
&trans   &trans     &trans    &trans     &trans     &trans         &trans   &trans      &trans     &trans     &trans     &trans     &trans
&trans   &kp AT     &kp LBKT  &kp DQT    &kp PIPE   &kp DLLR       &trans   &kp RBKT    &kp LT     &kp EQUAL  &kp GT     &kp PRCNT  &trans
&trans   &kp HASH   &kp LPAR  &kp SQT    &kp RPAR   &kp AMPS       &trans   &kp CARET   &kp PLUS   &kp MINUS  &kp STAR   &kp FSLH   &trans
&trans   &kp BSLH   &kp LBRC  &kp GRAVE  &kp RBRC   &kp TILDE      &trans   &kp UNDER   &kp EXCL   &kp QMARK  &kp COLON  &kp SEMI   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans   &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "SYMBOL(仮)";
        };
    };
};
