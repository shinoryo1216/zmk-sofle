// ZMK_POINTING_DEFAULT_MOVE_VAL / SCRL_VAL
#define ZMK_POINTING_DEFAULT_MOVE_VAL 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 1 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

/ {
    vel_move_x_listener: vel_move_x_listener {
        compatible = "zmk,input-listener";
        device = <&vel_move_x>;
    };
    vel_move_y_listener: vel_move_y_listener {
        compatible = "zmk,input-listener";
        device = <&vel_move_y>;
    };
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <80>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

/ {
    behaviors {
        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <7 8 9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44>;
            hold-trigger-on-release;
        };

        lt_thumb_space: lt_thumb_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        lt_thumb_comma: lt_thumb_comma {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&mm_thumb_comma>;
        };

        lt_thumb_dot2: lt_thumb_dot2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&mm_thumb_dot>;
        };

        // 3機能キー専用Hold-Tap
        mt_l1_r3_sym: mt_l1_r3_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt_r6_r3_sym: mt_r6_r3_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt_l1_r4_sym: mt_l1_r4_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt_r6_r4_sym: mt_r6_r4_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        rsr_cursor_ud: rsr_cursor_ud {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp DOWN_ARROW>;
            ccw-binding = <&kp UP_ARROW>;
        };

        rsr_cursor_lr: rsr_cursor_lr {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp RIGHT_ARROW>;
            ccw-binding = <&kp LEFT_ARROW>;
        };

        rsr_undo_redo: rsr_undo_redo {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LC(LS(Z))>;
            ccw-binding = <&kp LC(Z)>;
        };

        rsr_browser_nav: rsr_browser_nav {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LA(RIGHT)>;
            ccw-binding = <&kp LA(LEFT)>;
        };

        rsr_tab_nav: rsr_tab_nav {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp LC(TAB)>;
            ccw-binding = <&kp LC(LS(TAB))>;
        };

        vel_move_x: vel_move_x {
            compatible = "zmk,behavior-velocity-mouse-move";
            #binding-cells = <1>;
            input-code = <INPUT_REL_X>;
            min-move = <8>;
            max-move = <28>;
            min-interval-ms = <8>;
            max-interval-ms = <120>;
        };

        vel_move_y: vel_move_y {
            compatible = "zmk,behavior-velocity-mouse-move";
            #binding-cells = <1>;
            input-code = <INPUT_REL_Y>;
            min-move = <8>;
            max-move = <28>;
            min-interval-ms = <8>;
            max-interval-ms = <120>;
        };

        mouse_rot_lr: mouse_rot_lr {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&vel_move_x 1>, <&vel_move_x (-1)>;
        };

        mouse_rot_ud: mouse_rot_ud {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&vel_move_y 1>, <&vel_move_y (-1)>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        mm_row_comma: mm_row_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_dot: mm_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(RIGHT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_thumb_comma: mm_thumb_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(LEFT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_thumb_dot: mm_thumb_dot {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp LS(RIGHT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td_joystick_click: td_joystick_click {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&mkp LCLK>, <&mkp RCLK>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;
            label = "SHIFT_MCLK";
        };

        macro_nn: macro_nn {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X>, <&kp N>;
            label = "MACRO_NN";
        };

        macro_nakaguro: macro_nakaguro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z>, <&kp FSLH>;
            label = "MACRO_NAKAGURO";
        };

        // IME連動マクロ（OS切替キー送信＋キーボードレイヤー移動）
        macro_to_naginata: macro_to_naginata {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&to 3>;
            label = "MACRO_TO_NAGINATA";
        };

        macro_to_colemak: macro_to_colemak {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANG2>, <&to 2>;
            label = "MACRO_TO_COLEMAK";
        };

        // 薙刀式かな入力用マクロ
        macro_ki: macro_ki { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp K &kp I>; label = "NG_KI"; };
        macro_te: macro_te { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp T &kp E>; label = "NG_TE"; };
        macro_shi: macro_shi { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp S &kp I>; label = "NG_SHI"; };
        macro_su: macro_su { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp S &kp U>; label = "NG_SU"; };
        macro_ru: macro_ru { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp R &kp U>; label = "NG_RU"; };
        macro_re: macro_re { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp R &kp E>; label = "NG_RE"; };
        macro_he: macro_he { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp H &kp E>; label = "NG_HE"; };
        macro_ro: macro_ro { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp R &kp O>; label = "NG_RO"; };
        macro_ke: macro_ke { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp K &kp E>; label = "NG_KE"; };
        macro_to: macro_to { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp T &kp O>; label = "NG_TO"; };
        macro_ka: macro_ka { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp K &kp A>; label = "NG_KA"; };
        macro_xtu: macro_xtu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp X &kp T &kp U>; label = "NG_XTU"; };
        macro_ku: macro_ku { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp K &kp U>; label = "NG_KU"; };
        macro_ta: macro_ta { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp T &kp A>; label = "NG_TA"; };
        macro_ho: macro_ho { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp H &kp O>; label = "NG_HO"; };
        macro_hi: macro_hi { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp H &kp I>; label = "NG_HI"; };
        macro_ha: macro_ha { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp H &kp A>; label = "NG_HA"; };
        macro_ko: macro_ko { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp K &kp O>; label = "NG_KO"; };
        macro_so: macro_so { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp S &kp O>; label = "NG_SO"; };
        macro_na: macro_na { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp N &kp A>; label = "NG_NA"; };
        macro_ra: macro_ra { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp R &kp A>; label = "NG_RA"; };

        // 濁音・半濁音マクロ
        macro_ga: macro_ga { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp G &kp A>; label = "NG_GA"; };
        macro_gi: macro_gi { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp G &kp I>; label = "NG_GI"; };
        macro_gu: macro_gu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp G &kp U>; label = "NG_GU"; };
        macro_ge: macro_ge { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp G &kp E>; label = "NG_GE"; };
        macro_go: macro_go { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp G &kp O>; label = "NG_GO"; };
        macro_za: macro_za { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp Z &kp A>; label = "NG_ZA"; };
        macro_ji: macro_ji { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp Z &kp I>; label = "NG_JI"; };
        macro_zu: macro_zu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp Z &kp U>; label = "NG_ZU"; };
        macro_ze: macro_ze { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp Z &kp E>; label = "NG_ZE"; };
        macro_zo: macro_zo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp Z &kp O>; label = "NG_ZO"; };
        macro_da: macro_da { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp D &kp A>; label = "NG_DA"; };
        macro_di: macro_di { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp D &kp I>; label = "NG_DI"; };
        macro_de: macro_de { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp D &kp E>; label = "NG_DE"; };
        macro_do: macro_do { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp D &kp O>; label = "NG_DO"; };
        macro_ba: macro_ba { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp B &kp A>; label = "NG_BA"; };
        macro_bi: macro_bi { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp B &kp I>; label = "NG_BI"; };
        macro_bu: macro_bu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp B &kp U>; label = "NG_BU"; };
        macro_be: macro_be { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp B &kp E>; label = "NG_BE"; };
        macro_bo: macro_bo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp B &kp O>; label = "NG_BO"; };
        macro_pa: macro_pa { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp P &kp A>; label = "NG_PA"; };
        macro_pi: macro_pi { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp P &kp I>; label = "NG_PI"; };
        macro_pu: macro_pu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp P &kp U>; label = "NG_PU"; };
        macro_pe: macro_pe { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp P &kp E>; label = "NG_PE"; };
        macro_po: macro_po { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp P &kp O>; label = "NG_PO"; };

        // センターシフト出力用マクロ
        macro_sa: macro_sa { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp S &kp A>; label = "NG_SA"; };
        macro_yo: macro_yo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp Y &kp O>; label = "NG_YO"; };
        macro_yu: macro_yu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp Y &kp U>; label = "NG_YU"; };
        macro_ya: macro_ya { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp Y &kp A>; label = "NG_YA"; };
        macro_no: macro_no { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp N &kp O>; label = "NG_NO"; };
        macro_mo: macro_mo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp M &kp O>; label = "NG_MO"; };
        macro_tsu: macro_tsu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp T &kp U>; label = "NG_TSU"; };
        macro_fu: macro_fu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp H &kp U>; label = "NG_FU"; };
        macro_mu: macro_mu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp M &kp U>; label = "NG_MU"; };
        macro_wa: macro_wa { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp W &kp A>; label = "NG_WA"; };
        macro_ne: macro_ne { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp N &kp E>; label = "NG_NE"; };
        macro_ri: macro_ri { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp R &kp I>; label = "NG_RI"; };
        macro_me: macro_me { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp M &kp E>; label = "NG_ME"; };
        macro_se: macro_se { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp S &kp E>; label = "NG_SE"; };
        macro_mi: macro_mi { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp M &kp I>; label = "NG_MI"; };
        macro_ni: macro_ni { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp N &kp I>; label = "NG_NI"; };
        macro_ma: macro_ma { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp M &kp A>; label = "NG_MA"; };
        macro_ti: macro_ti { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp T &kp I>; label = "NG_TI"; };
        macro_wo: macro_wo { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp W &kp O>; label = "NG_WO"; };
        macro_nu: macro_nu { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp N &kp U>; label = "NG_NU"; };

        // 記号マクロ
        macro_bracket_double_open: macro_bracket_double_open { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(RBKT)>; label = "MACRO_BRACKET_DOUBLE_OPEN"; };
        macro_bracket_double_close: macro_bracket_double_close { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(BSLH)>; label = "MACRO_BRACKET_DOUBLE_CLOSE"; };
        macro_dash_double: macro_dash_double { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp INT1 &kp INT1>; label = "MACRO_DASH_DOUBLE"; };
        macro_excl: macro_excl { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LS(N1)>; label = "MACRO_EXCL"; };
    };

    combos {
        compatible = "zmk,combos";

        /* ---- ベースレイヤー（Layer 0, 1, 2, 3）共通基本コンボ ---- */
        combo_space_jkl {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <34 35>;
            bindings = <&kp SPACE>;
            layers = <0 1 2 3>;
        };

        combo_space_sdf {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <29 30>;
            bindings = <&kp SPACE>;
            layers = <0 1 2 3>;
        };

        // G+H (pos 31, 33) -> Space (QWERTY位置基準)
        combo_space_gh {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <31 33>;
            bindings = <&kp SPACE>;
            layers = <0 1 2 3>;
        };

        combo_bspc_mcommadot {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <47 48>;
            bindings = <&kp BSPC>;
            layers = <0 1 2 3>;
        };

        combo_bspc_xcv {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <42 43>;
            bindings = <&kp BSPC>;
            layers = <0 1 2 3>;
        };

        // V+M (pos 43, 47) -> Backspace (QWERTY位置基準)
        combo_bspc_vm {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <43 47>;
            bindings = <&kp BSPC>;
            layers = <0 1 2 3>;
        };

        combo_hankaku_uio {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <21 22>;
            bindings = <&kp GRAVE>;
            layers = <0 1>;
        };

        combo_hankaku_wer {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <16 17>;
            bindings = <&kp GRAVE>;
            layers = <0 1>;
        };

        // R+U (pos 17, 21) -> IMEトグル (QWERTY位置基準)
        combo_ime_toggle_ru {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <17 21>;
            bindings = <&kp GRAVE>;
            layers = <0 1 2 3>;
        };

        /* ---- IME連動切替（Layer 0, 1 では標準キー、Layer 2, 3 ではColemak/薙刀式自動切替） ---- */
        combo_ime_japanese {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp LANG1>;
            layers = <0 1>;
        };

        combo_ime_english {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp LANG2>;
            layers = <0 1>;
        };

        // System C：4+5 および U+I / E+R で 薙刀式 (Layer 3) へ遷移
        combo_ime_naginata_45 {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&macro_to_naginata>;
            layers = <2>;
        };
        combo_ime_naginata_ui {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&macro_to_naginata>;
            layers = <2>;
        };
        combo_ime_naginata_er {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&macro_to_naginata>;
            layers = <2>;
        };

        // System C：6+7 および U+I / E+R で Colemak (Layer 2) へ遷移
        combo_ime_colemak_67 {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&macro_to_colemak>;
            layers = <3>;
        };
        combo_ime_colemak_ui {
            timeout-ms = <50>;
            key-positions = <21 22>;
            bindings = <&macro_to_colemak>;
            layers = <3>;
        };
        combo_ime_colemak_er {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&macro_to_colemak>;
            layers = <3>;
        };

        /* ---- システム直接切替コンボ (System A / B / C) ----
         * 左親指 L2+L3 (53 54) または 右親指 R4+R5 (62 63) と 数字キー(1/2/3) の組み合わせ
         */
        // 左手トリガー (L2+L3: 53 54) + 1/2/3
        combo_sys_a_left {
            timeout-ms = <60>;
            key-positions = <1 53 54>;
            bindings = <&to 0>;
        };
        combo_sys_b_left {
            timeout-ms = <60>;
            key-positions = <2 53 54>;
            bindings = <&to 1>;
        };
        combo_sys_c_left {
            timeout-ms = <60>;
            key-positions = <3 53 54>;
            bindings = <&to 2>;
        };

        // 右手トリガー (R4+R5: 62 63) + 1/2/3
        combo_sys_a_right {
            timeout-ms = <60>;
            key-positions = <1 62 63>;
            bindings = <&to 0>;
        };
        combo_sys_b_right {
            timeout-ms = <60>;
            key-positions = <2 62 63>;
            bindings = <&to 1>;
        };
        combo_sys_c_right {
            timeout-ms = <60>;
            key-positions = <3 62 63>;
            bindings = <&to 2>;
        };

        // 右手片手用 (R4+R5: 62 63) + 右手側数字キー 6/7/8 (7 8 9)
        combo_sys_a_rh {
            timeout-ms = <60>;
            key-positions = <7 62 63>;
            bindings = <&to 0>;
        };
        combo_sys_b_rh {
            timeout-ms = <60>;
            key-positions = <8 62 63>;
            bindings = <&to 1>;
        };
        combo_sys_c_rh {
            timeout-ms = <60>;
            key-positions = <9 62 63>;
            bindings = <&to 2>;
        };

        /* ---- Layer 1 (大西配列) 専用コンボ ---- */
        combo_onishi_nn {
            timeout-ms = <50>;
            require-prior-idle-ms = <125>;
            key-positions = <35 36>;
            bindings = <&macro_nn>;
            layers = <1>;
        };

        /* ---- ウィンドウ管理コンボ（Layer 8） ---- */
        combo_l2_mb4_mcomma { timeout-ms = <50>; key-positions = <47 48>; bindings = <&mkp MB4>; layers = <8>; };
        combo_l2_mb4_cx     { timeout-ms = <50>; key-positions = <41 42>; bindings = <&mkp MB4>; layers = <8>; };
        combo_l2_mb5_commadot{ timeout-ms = <50>; key-positions = <48 49>; bindings = <&mkp MB5>; layers = <8>; };
        combo_l2_mb5_cv     { timeout-ms = <50>; key-positions = <42 43>; bindings = <&mkp MB5>; layers = <8>; };
        combo_l2_maximize_ui{ timeout-ms = <50>; key-positions = <21 22>; bindings = <&kp LG(W)>; layers = <7 8>; };
        combo_l2_maximize_er{ timeout-ms = <50>; key-positions = <16 17>; bindings = <&kp LG(W)>; layers = <7 8>; };
        combo_l2_close_io   { timeout-ms = <50>; key-positions = <22 23>; bindings = <&kp LG(C)>; layers = <7 8>; };
        combo_l2_close_we   { timeout-ms = <50>; key-positions = <15 16>; bindings = <&kp LG(C)>; layers = <7 8>; };
        combo_l2_mission_jkl{ timeout-ms = <50>; key-positions = <34 35 36>; bindings = <&kp LG(TAB)>; layers = <8>; };
        combo_l2_mission_sdf{ timeout-ms = <50>; key-positions = <28 29 30>; bindings = <&kp LG(TAB)>; layers = <8>; };

        /* ---- Layer 9 (マウス) 専用コンボ ---- */
        combo_l4_lclk_ui { timeout-ms = <50>; key-positions = <21 22>; bindings = <&mkp LCLK>; layers = <9>; };
        combo_l4_lclk_er { timeout-ms = <50>; key-positions = <16 17>; bindings = <&mkp LCLK>; layers = <9>; };
        combo_l4_mclk_uio{ timeout-ms = <50>; key-positions = <21 22 23>; bindings = <&mkp MCLK>; layers = <9>; };
        combo_l4_mclk_wer{ timeout-ms = <50>; key-positions = <15 16 17>; bindings = <&mkp MCLK>; layers = <9>; };
        combo_l4_rclk_io { timeout-ms = <50>; key-positions = <22 23>; bindings = <&mkp RCLK>; layers = <9>; };
        combo_l4_rclk_we { timeout-ms = <50>; key-positions = <15 16>; bindings = <&mkp RCLK>; layers = <9>; };

        /* ---- レイヤーアクセス用コンボ（全レイヤー共通） ---- */
        combo_mo_fkeys_left  { timeout-ms = <50>; key-positions = <56 57>; bindings = <&mo 10>; };
        combo_mo_fkeys_right { timeout-ms = <50>; key-positions = <59 60>; bindings = <&mo 10>; };
        combo_layer_bt_left  { timeout-ms = <150>; key-positions = <53 54 55 56 57>; bindings = <&mo 11>; };
        combo_layer_bt_right { timeout-ms = <150>; key-positions = <59 60 61 62 63>; bindings = <&mo 11>; };

        /* ---- System C：3機能キー センターシフト同時押しコンボ (Layer 2, 3) ---- */
        combo_cs_l1_row3 { timeout-ms = <60>; key-positions = <26 57>; bindings = <&kp LS(COMMA)>; layers = <2 3>; };
        combo_cs_r6_row3 { timeout-ms = <60>; key-positions = <38 59>; bindings = <&kp LS(DOT)>; layers = <2 3>; };
        combo_cs_l1_row4 { timeout-ms = <60>; key-positions = <39 57>; bindings = <&macro_bracket_double_open>; layers = <2 3>; };
        combo_cs_r6_row4 { timeout-ms = <60>; key-positions = <51 59>; bindings = <&macro_bracket_double_close>; layers = <2 3>; };

        /* ---- System C：薙刀式 濁音・半濁音コンボ (Layer 3) ---- */
        combo_ng_ga { timeout-ms = <60>; key-positions = <30 34>; bindings = <&macro_ga>; layers = <3>; };
        combo_ng_gi { timeout-ms = <60>; key-positions = <15 34>; bindings = <&macro_gi>; layers = <3>; };
        combo_ng_gu { timeout-ms = <60>; key-positions = <30 33>; bindings = <&macro_gu>; layers = <3>; };
        combo_ng_ge { timeout-ms = <60>; key-positions = <28 34>; bindings = <&macro_ge>; layers = <3>; };
        combo_ng_go { timeout-ms = <60>; key-positions = <34 43>; bindings = <&macro_go>; layers = <3>; };
        combo_ng_za { timeout-ms = <60>; key-positions = <21 30>; bindings = <&macro_za>; layers = <3>; };
        combo_ng_ji { timeout-ms = <60>; key-positions = <17 34>; bindings = <&macro_ji>; layers = <3>; };
        combo_ng_zu { timeout-ms = <60>; key-positions = <23 30>; bindings = <&macro_zu>; layers = <3>; };
        combo_ng_ze { timeout-ms = <60>; key-positions = <27 34>; bindings = <&macro_ze>; layers = <3>; };
        combo_ng_zo { timeout-ms = <60>; key-positions = <34 44>; bindings = <&macro_zo>; layers = <3>; };
        combo_ng_da { timeout-ms = <60>; key-positions = <30 46>; bindings = <&macro_da>; layers = <3>; };
        combo_ng_di { timeout-ms = <60>; key-positions = <31 34>; bindings = <&macro_di>; layers = <3>; };
        combo_ng_de { timeout-ms = <60>; key-positions = <16 34>; bindings = <&macro_de>; layers = <3>; };
        combo_ng_do { timeout-ms = <60>; key-positions = <29 34>; bindings = <&macro_do>; layers = <3>; };
        combo_ng_ba { timeout-ms = <60>; key-positions = <34 42>; bindings = <&macro_ba>; layers = <3>; };
        combo_ng_bi { timeout-ms = <60>; key-positions = <34 41>; bindings = <&macro_bi>; layers = <3>; };
        combo_ng_bu { timeout-ms = <60>; key-positions = <30 37>; bindings = <&macro_bu>; layers = <3>; };
        combo_ng_be { timeout-ms = <60>; key-positions = <24 30>; bindings = <&macro_be>; layers = <3>; };
        combo_ng_bo { timeout-ms = <60>; key-positions = <34 40>; bindings = <&macro_bo>; layers = <3>; };
        combo_ng_pa { timeout-ms = <60>; key-positions = <42 47>; bindings = <&macro_pa>; layers = <3>; };
        combo_ng_pi { timeout-ms = <60>; key-positions = <41 47>; bindings = <&macro_pi>; layers = <3>; };
        combo_ng_pu { timeout-ms = <60>; key-positions = <37 43>; bindings = <&macro_pu>; layers = <3>; };
        combo_ng_pe { timeout-ms = <60>; key-positions = <24 43>; bindings = <&macro_pe>; layers = <3>; };
        combo_ng_po { timeout-ms = <60>; key-positions = <40 47>; bindings = <&macro_po>; layers = <3>; };

        /* ---- System C：薙刀式 センターシフトコンボ (Layer 3) ---- */
        combo_cs_su_sa { timeout-ms = <60>; key-positions = <21 57>; bindings = <&macro_sa>; layers = <3>; };
        combo_cs_ru_yo { timeout-ms = <60>; key-positions = <22 57>; bindings = <&macro_yo>; layers = <3>; };
        combo_cs_re_e  { timeout-ms = <60>; key-positions = <23 57>; bindings = <&kp E>; layers = <3>; };
        combo_cs_he_yu { timeout-ms = <60>; key-positions = <24 57>; bindings = <&macro_yu>; layers = <3>; };
        combo_cs_ku_ya { timeout-ms = <60>; key-positions = <33 57>; bindings = <&macro_ya>; layers = <3>; };
        combo_cs_ta_no { timeout-ms = <60>; key-positions = <34 57>; bindings = <&macro_no>; layers = <3>; };
        combo_cs_i_mo  { timeout-ms = <60>; key-positions = <35 57>; bindings = <&macro_mo>; layers = <3>; };
        combo_cs_u_tsu { timeout-ms = <60>; key-positions = <36 57>; bindings = <&macro_tsu>; layers = <3>; };
        combo_cs_a_fu  { timeout-ms = <60>; key-positions = <37 57>; bindings = <&macro_fu>; layers = <3>; };
        combo_cs_na_o  { timeout-ms = <60>; key-positions = <47 57>; bindings = <&kp O>; layers = <3>; };
        combo_cs_n_mu  { timeout-ms = <60>; key-positions = <48 57>; bindings = <&macro_mu>; layers = <3>; };
        combo_cs_ra_wa { timeout-ms = <60>; key-positions = <49 57>; bindings = <&macro_wa>; layers = <3>; };
        combo_cs_q_excl { timeout-ms = <60>; key-positions = <50 57>; bindings = <&macro_excl>; layers = <3>; };
        combo_cs_dash_db { timeout-ms = <60>; key-positions = <46 57>; bindings = <&macro_dash_double>; layers = <3>; };

        combo_cs_ki_ne { timeout-ms = <60>; key-positions = <15 59>; bindings = <&macro_ne>; layers = <3>; };
        combo_cs_te_ri { timeout-ms = <60>; key-positions = <16 59>; bindings = <&macro_ri>; layers = <3>; };
        combo_cs_shi_me{ timeout-ms = <60>; key-positions = <17 59>; bindings = <&macro_me>; layers = <3>; };
        combo_cs_ro_se { timeout-ms = <60>; key-positions = <27 59>; bindings = <&macro_se>; layers = <3>; };
        combo_cs_ke_mi { timeout-ms = <60>; key-positions = <28 59>; bindings = <&macro_mi>; layers = <3>; };
        combo_cs_to_ni { timeout-ms = <60>; key-positions = <29 59>; bindings = <&macro_ni>; layers = <3>; };
        combo_cs_ka_ma { timeout-ms = <60>; key-positions = <30 59>; bindings = <&macro_ma>; layers = <3>; };
        combo_cs_xtu_chi{ timeout-ms = <60>; key-positions = <31 59>; bindings = <&macro_ti>; layers = <3>; };
        combo_cs_ha_wo { timeout-ms = <60>; key-positions = <42 59>; bindings = <&macro_wo>; layers = <3>; };
        combo_cs_ko_nu { timeout-ms = <60>; key-positions = <43 59>; bindings = <&macro_nu>; layers = <3>; };
        combo_cs_so_nakaguro{ timeout-ms = <60>; key-positions = <44 59>; bindings = <&macro_nakaguro>; layers = <3>; };
    };

    keymap {
        compatible = "zmk,keymap";

        // ==========================================
        // 1. ベースレイヤー群 (Layers 0, 1, 2, 3)
        // ==========================================

        layer_0_qwerty {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp MINUS
&kp TAB     &kp Q      &kp W         &kp E         &kp R         &kp T        &kp DOWN_ARROW   &kp Y      &kp U         &kp I         &kp O      &kp P       &kp LBKT
&kp LCTRL   &kp A      &hml LCTRL S  &kp D         &hml LSHFT F  &kp G        &kp LEFT_ARROW   &kp H      &hmr RSHFT J  &kp K         &hmr RCTRL L &kp SEMI  &kp SQT
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V         &kp B        &kp RIGHT_ARROW  &kp N      &kp M         &mm_row_comma &mm_dot    &kp LS(FSLH) &kp RSHFT
&tog 14     &kp LALT   &lt 9 PSCRN   &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 4 0 &td_joystick_click &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L0 BASE";
        };

        layer_1_onishi {
            bindings = <
&kp ESC     &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp LG(SPACE)
&kp TAB     &kp Q      &kp L         &kp U         &kp F         &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &kp W    &kp R         &kp Y      &kp P       &kp UP_ARROW
&kp LCTRL   &kp E      &hml LCTRL I  &kp A         &hml LSHFT O  &kp MINUS    &kp LEFT_ARROW   &kp K      &hmr RSHFT T  &kp N         &hmr RCTRL S &kp H     &kp DOWN_ARROW
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V         &kp LS(FSLH) &kp RIGHT_ARROW  &kp G      &kp D         &kp M         &kp J      &kp B       &kp RSHFT
&tog 14     &kp LALT   &lt 9 PSCRN   &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 5 0 &td_joystick_click &lt_thumb 5 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L1 ONISHI";
        };

        layer_2_colemak {
            bindings = <
&kp ESC                 &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp LG(SPACE)
&kp TAB                 &kp Q      &kp W         &kp F         &kp P         &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &kp L    &kp U         &kp Y      &kp LS(N7)  &kp MINUS
&mt_l1_r3_sym LCTRL LS(N8) &kp A   &hml LCTRL R  &kp S         &hml LSHFT T  &kp G        &kp LEFT_ARROW   &kp M      &hmr RSHFT N  &kp E         &hmr RCTRL I &kp O     &mt_r6_r3_sym RCTRL LS(N9)
&mt_l1_r4_sym LSHFT RBKT   &kp Z   &kp X         &kp C         &kp D         &kp V        &kp RIGHT_ARROW  &kp K      &kp H         &kp B         &kp J      &kp LS(FSLH) &mt_r6_r4_sym RSHFT BSLH
&tog 14     &kp LALT   &lt 9 PSCRN   &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 6 0 &td_joystick_click &lt_thumb 6 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L2 COLEMAK";
        };

        layer_3_naginata {
            bindings = <
&kp ESC                 &kp N1     &kp N2        &kp N3        &kp N4        &kp N5       &kp UP_ARROW     &kp N6     &kp N7        &kp N8        &kp N9     &kp N0      &kp LG(SPACE)
&kp TAB                 &kp X      &macro_ki     &macro_te     &macro_shi    &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &macro_su &macro_ru    &macro_re  &macro_he   &kp FSLH
&mt_l1_r3_sym LCTRL LS(N8) &macro_ro &macro_ke  &macro_to     &macro_ka     &macro_xtu   &kp LEFT_ARROW   &macro_ku  &macro_ta     &kp I         &kp U      &kp A       &mt_r6_r3_sym RCTRL RBKT
&mt_l1_r4_sym LSHFT RBKT   &macro_ho &macro_hi  &macro_ha     &macro_ko     &macro_so    &kp RIGHT_ARROW  &kp MINUS  &macro_na     &macro_nn     &macro_ra  &kp LS(FSLH) &mt_r6_r4_sym RSHFT BSLH
&tog 14     &kp LALT   &lt 9 PSCRN   &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 6 0 &td_joystick_click &lt_thumb 6 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L3 NAGINATA";
        };

        // ==========================================
        // 2. 記号レイヤー群 (Layers 4, 5, 6)
        // ==========================================

        layer_4_symbol {
            bindings = <
&kp ESC     &kp N1           &kp N2          &kp N3           &kp N4           &kp N5             &kp LC(C)        &kp N6           &kp N7           &kp N8      &kp N9     &kp N0            &kp MINUS
&kp TAB     &none            &none           &none            &none            &none              &kp LC(V)        &kp LS(RBKT)     &kp LS(BSLH)     &kp RBKT    &kp BSLH   &kp LS(LBKT)      &kp LS(INT3)
&kp LCTRL   &kp LS(N1)       &kp LS(N2)      &kp LS(N3)       &kp LS(N4)       &kp LS(N5)         &kp LC(Z)        &kp LS(N6)       &kp LS(N7)       &kp LS(N8)  &kp LS(N9) &kp EQUAL         &kp LS(EQUAL)
&kp LSHFT   &kp LS(SQT)      &kp LS(SEMI)    &kp MINUS        &kp FSLH         &kp LS(MINUS)      &kp LC(LS(Z))    &kp LS(INT1)     &kp INT3         &kp LS(COMMA) &kp LS(DOT) &kp FSLH      &kp INT1
&tog 14     &kp LALT         &lt 9 PSCRN     &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 4 0 &kp LC(A)     &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_undo_redo &rsr_trans>;
            display-name = "L4 SYMBOL";
        };

        layer_5_onishi_symbol {
            bindings = <
&kp ESC   &kp N1     &kp N2    &kp N3     &kp N4     &kp N5              &kp LC(C)       &kp N6         &kp N7        &kp N8        &kp N9      &kp N0      &none
&kp TAB   &macro_nakaguro &kp RBKT &kp LS(N2) &kp BSLH &kp UP_ARROW      &kp LC(V)       &kp DOWN_ARROW &kp LT        &kp LS(MINUS) &kp GT      &kp LS(INT3) &none
&kp EQUAL &kp HASH   &kp LS(N8) &kp LS(N7) &kp LS(N9) &kp LS(EQUAL)      &kp LC(Z)       &kp LS(N6)     &kp LS(SEMI)  &kp MINUS     &kp LS(SQT) &kp FSLH    &kp INT1
&kp LSHFT &kp DLLR   &kp LS(RBKT) &kp LS(LBKT) &kp LS(BSLH) &kp EXCL     &kp LC(LS(Z))   &kp LS(INT1)   &kp SQT       &kp SEMI      &kp PRCNT   &kp LBKT    &kp RSHFT
&tog 14   &kp LALT   &lt 9 PSCRN &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 5 0 &kp LC(A)      &lt_thumb 5 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_undo_redo &rsr_trans>;
            display-name = "L5 ONISHI SYM";
        };

        layer_6_sym3 {
            bindings = <
&kp ESC   &kp N1     &kp N2    &kp N3     &kp N4     &kp N5              &kp LC(C)       &kp N6         &kp N7        &kp N8        &kp N9      &kp N0      &none
&kp TAB   &none      &kp DLLR  &kp HASH   &kp GRAVE  &kp UP_ARROW        &kp LC(V)       &kp DOWN_ARROW &none         &kp PLUS      &kp ASTRK   &none       &none
&kp LT    &kp PRCNT  &kp LBKT  &kp AMPS   &kp LS(N2) &kp LS(EQUAL)       &kp LC(Z)       &kp LS(INT1)   &kp EQUAL     &kp MINUS     &kp FSLH    &kp INT3    &kp GT
&kp LS(RBKT) &none   &none     &none      &none      &none               &kp LC(LS(Z))   &none          &kp SQT       &kp SEMI      &kp LS(INT3) &kp EXCL    &kp LS(BSLH)
&tog 14   &kp LALT   &lt 9 PSCRN &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 6 0 &kp LC(A)      &lt_thumb 6 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_undo_redo &rsr_trans>;
            display-name = "L6 SYM3";
        };

        // ==========================================
        // 3. 共通機能レイヤー群 (Layers 7, 8, 9, 10, 11)
        // ==========================================

        layer_7_cursor {
            bindings = <
&kp ESC   &none      &none     &none      &none      &none               &none           &none          &none         &none         &none       &none       &none
&kp TAB   &kp HOME   &kp PG_UP &kp UP_ARROW &kp PG_DN &kp END            &none           &kp END        &kp PG_DN     &kp UP_ARROW  &kp PG_UP   &kp HOME    &none
&kp LCTRL &none      &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &none &kp LA(LEFT)    &none          &kp LEFT_ARROW &kp DOWN_ARROW &kp RIGHT_ARROW &none  &none
&kp LSHFT &none      &none     &none      &none      &none               &kp LA(RIGHT)   &none          &none         &none         &none       &none       &kp RSHFT
&tog 14   &kp LALT   &lt 9 PSCRN &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 4 0 &mkp MCLK     &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_browser_nav &rsr_trans>;
            display-name = "L7 CURSOR";
        };

        layer_8_window {
            bindings = <
&kp LG(FSLH)       &none              &none          &none          &none          &none              &none           &none              &none          &none          &none          &none          &kp LG(FSLH)
&kp LG(LS(COMMA))  &kp LG(LS(K))      &kp LG(COMMA)  &kp LG(UP)     &kp LG(DOT)    &kp LG(LS(J))      &none           &kp LG(LS(K))      &kp LG(COMMA)  &kp LG(UP)     &kp LG(DOT)    &kp LG(LS(J))  &kp LG(LS(COMMA))
&kp LG(LS(DOT))    &kp LG(K)          &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(RIGHT)  &kp LG(J)          &kp LC(LS(TAB)) &kp LG(K)          &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(RIGHT)  &kp LG(J)      &kp LG(LS(DOT))
&kp LG(M)          &kp LG(R)          &kp LG(B)      &kp LG(ENTER)  &kp LG(E)      &kp LG(SPACE)      &kp LC(TAB)     &kp LG(SPACE)      &kp LG(E)      &kp LG(ENTER)  &kp LG(B)      &kp LG(R)      &kp LG(M)
&tog 14   &kp LALT   &lt 9 PSCRN &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 4 0 &mkp MCLK      &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_tab_nav &rsr_trans>;
            display-name = "L8 WINDOW";
        };

        layer_9_mouse {
            bindings = <
&kp ESC   &none      &none     &none      &none      &none               &mmv MOVE_UP    &none          &none         &none         &none       &none       &none
&kp TAB   &kp HOME   &kp PG_UP &mmv MOVE_UP &kp PG_DN &kp END            &mmv MOVE_DOWN  &kp END        &kp PG_DN     &mmv MOVE_UP  &kp PG_UP   &kp HOME    &none
&kp LCTRL &none      &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &mmv MOVE_LEFT  &none          &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none
&kp LSHFT &none      &none     &none      &none      &none               &mmv MOVE_RIGHT &none          &none         &none         &none       &none       &none
&tog 14   &kp LALT   &lt 9 PSCRN &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 4 0 &mkp MCLK      &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&mouse_rot_lr &rsr_trans>;
            display-name = "L9 MOUSE";
        };

        layer_10_fkeys {
            bindings = <
&kp ESC   &kp F1     &kp F2    &kp F3     &kp F4     &kp F5              &kp UP_ARROW    &kp F6         &kp F7        &kp F8        &kp F9      &kp F10     &none
&kp TAB   &kp F11    &kp F12   &none      &none      &none               &kp DOWN_ARROW  &none          &none         &none         &none       &none       &none
&kp LCTRL &none      &none     &none      &none      &none               &kp LEFT_ARROW  &none          &none         &none         &none       &none       &none
&kp LSHFT &none      &none     &none      &none      &none               &kp RIGHT_ARROW &none          &none         &none         &none       &none       &none
&tog 14   &kp LALT   &lt 9 PSCRN &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 4 0 &mkp MCLK      &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L10 FKEYS";
        };

        layer_11_bluetooth {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp UP_ARROW   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&bootloader &none         &none         &none         &none         &none         &kp DOWN_ARROW &none         &none         &none         &none         &none         &bootloader
&none       &none         &none         &none         &none         &none         &kp LEFT_ARROW &none         &none         &none         &none         &none         &none
&none       &none         &none         &none         &none         &none         &kp RIGHT_ARROW &none        &none         &none         &none         &none         &none
&tog 14     &kp LALT      &lt 9 PSCRN   &lt_thumb 7 BSPC &lt_thumb_comma 8 0 &lt_thumb_dot2 4 0 &mkp MCLK &lt_thumb 4 ENTER &lt_thumb_space 8 SPACE &lt_thumb 7 BSPC &lt 9 DEL &lt 9 ESC
            >;
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L11 BLUETOOTH";
        };

        // ==========================================
        // 4. エンコーダー制御・マーカー・上書きレイヤー群 (Layers 12..18)
        // ==========================================

        layer_12_encoder_lr {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&rsr_cursor_lr &rsr_trans>;
            display-name = "L12 ENCODER LR";
        };

        layer_13_mouse_enc_ud {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&mouse_rot_ud &rsr_trans>;
            display-name = "L13 MOUSE ENC UD";
        };

        layer_14_push_marker {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            display-name = "L14 PUSH MARKER";
        };

        layer_15_ov_undo_redo {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&rsr_undo_redo &rsr_trans>;
            display-name = "L15 PUSH PASSTHRU";
        };

        layer_16_ov_browser_nav {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&rsr_browser_nav &rsr_trans>;
            display-name = "L16 PUSH PASSTHRU";
        };

        layer_17_ov_tab_nav {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&rsr_tab_nav &rsr_trans>;
            display-name = "L17 PUSH PASSTHRU";
        };

        layer_18_ov_cursor_ud {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&rsr_cursor_ud &rsr_trans>;
            display-name = "L18 PUSH PASSTHRU";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // ① フォールバック：Layer 14 (マーカー) 単体ONなら常に Layer 12 (矢印左右)
        cl_l14 { if-layers = <14>; then-layer = <12>; };

        // ② 上書き：記号レイヤー 4, 5, 6 ＋ Layer 14 → Layer 15 (undo/redo維持)
        cl_l4_l14 { if-layers = <4 14>; then-layer = <15>; };
        cl_l5_l14 { if-layers = <5 14>; then-layer = <15>; };
        cl_l6_l14 { if-layers = <6 14>; then-layer = <15>; };

        // カーソルレイヤー 7 ＋ Layer 14 → Layer 16 (browser-nav維持)
        cl_l7_l14 { if-layers = <7 14>; then-layer = <16>; };

        // ウィンドウレイヤー 8 ＋ Layer 14 → Layer 17 (tab-nav維持)
        cl_l8_l14 { if-layers = <8 14>; then-layer = <17>; };

        // マウスレイヤー 9 ＋ Layer 14 → Layer 13 (マウス上下)
        cl_l9_l14 { if-layers = <9 14>; then-layer = <13>; };

        // Fキーレイヤー 10 / BTレイヤー 11 ＋ Layer 14 → Layer 18 (cursor-ud維持)
        cl_l10_l14 { if-layers = <10 14>; then-layer = <18>; };
        cl_l11_l14 { if-layers = <11 14>; then-layer = <18>; };
    };
};
